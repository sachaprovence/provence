# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# stockage local du fournisseur de fichiers démo (v1.1, AR-0162) — jamais commité, comme /uploads d'un déploiement réel
/storage-demo

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# fichiers de référence générés par 'prisma init' (skills agent IA, hors périmètre applicatif)
.agents/
.claude/skills/
.windsurf/
skills-lock.json
