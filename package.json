{
  "name": "provence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,mjs}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/golden-path.mjs",
    "test:e2e:tenants": "node tests/e2e/two-organizations-isolation.mjs",
    "test:e2e:automation": "node tests/e2e/automation-golden-path.mjs",
    "test:e2e:onboarding": "node tests/e2e/self-service-onboarding.mjs",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "NODE_OPTIONS=--require=./prisma/seed-server-only-cjs-hook.cjs tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "test:migrations:fresh": "tsx scripts/test-migrations-fresh-db.ts",
    "backup:db": "tsx scripts/backup-database.ts",
    "backup:db:verify": "tsx scripts/verify-database-backup.ts",
    "backup:s3": "tsx scripts/backup-s3-objects.ts",
    "backup:s3:verify": "tsx scripts/verify-s3-backup.ts",
    "backup:consistency-check": "tsx scripts/check-storage-db-consistency.ts",
    "backup:metrics-report": "tsx scripts/backup-metrics-report.ts",
    "integrations:validate": "NODE_OPTIONS=--require=./prisma/seed-server-only-cjs-hook.cjs tsx scripts/validate-integrations.ts",
    "verify:graceful-shutdown": "node scripts/verify-graceful-shutdown.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "next": "16.3.0",
    "nodemailer": "^9.0.3",
    "papaparse": "^5.5.4",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "prisma": "^7.9.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/env": "^16.2.12",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/smtp-server": "^3.5.13",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.62.0",
    "prettier": "^3.9.6",
    "smtp-server": "^3.19.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
