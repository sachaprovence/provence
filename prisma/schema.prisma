  workspaceId    String?
  icpId          String?
  territoryId    String?
  sourceId       String?
  campaignId     String?
  assignedToId   String?
  /// Regroupement optionnel sous une même entité juridique (v0.9, ADR 0038) — jamais requis.
  companyId      String?

  establishmentName String
  category          LeadCategory @default(OTHER)
  stage             LeadStage    @default(NEW)

  websiteUrl       String?
  publicListingUrl String?
  address          String?
  city             String?
  region           String?
  country          String  @default("France")
  latitude         Float?
  longitude        Float?

  reviewCount   Int?
  averageRating Float?
  socialLinks   Json?

  hasVirtualTour Boolean?
  closedBusiness Boolean  @default(false)

  tagsRelation Tag[]   @relation("LeadTags")
  notesLegacy  String?

  isSuppressed Boolean   @default(false)
  suppressedAt DateTime?

  importedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?            @relation(fields: [workspaceId], references: [id])
  icp          IdealCustomerProfile? @relation(fields: [icpId], references: [id])
  territory    Territory?            @relation(fields: [territoryId], references: [id])
  source       LeadSource?           @relation(fields: [sourceId], references: [id])
  campaign     Campaign?             @relation(fields: [campaignId], references: [id])
  company      Company?              @relation(fields: [companyId], references: [id])

  contacts      LeadContact[]
  contactLinks  LeadContactRelation[]
  analyses      LeadAnalysis[]
  scores        LeadScore[]
  notes         LeadNote[]
  enrollments   Enrollment[]
  messages      Message[]
  conversations Conversation[]
  tasks         Task[]
  appointments  Appointment[]
  opportunities Opportunity[]
  quotes        Quote[]
  customer      Customer?
  aiRequests    AIRequest[]
  auditLogs     AuditLog[]
  properties    Property[]
  virtualTours  VirtualTour[]
  invoices      Invoice[]

  @@unique([organizationId, publicListingUrl])
  @@index([organizationId, stage])
  @@index([organizationId, city])
  @@index([campaignId])
  @@index([workspaceId])
  @@index([companyId])
}

model LeadContact {
