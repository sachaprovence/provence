enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

model Task {
  id             String     @id @default(cuid())
  organizationId String
  leadId         String?
  assigneeId     String?
  title          String
  description    String?
  dueAt          DateTime?
  status         TaskStatus @default(OPEN)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id])
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([organizationId, status])
  @@index([assigneeId])
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id             String            @id @default(cuid())
  organizationId String
  leadId         String
  ownerId        String?
  title          String
  startAt        DateTime
  endAt          DateTime
  location       String?
  status         AppointmentStatus @default(SCHEDULED)
  notes          String?
  summary        String?
  nextAction     String?
  /// Identifiant de l'évènement Google Calendar correspondant (v0.9) — présent = synchronisé.
  googleEventId  String?
  googleSyncedAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  owner        User?        @relation("AppointmentOwner", fields: [ownerId], references: [id])

  @@index([organizationId])
  @@index([leadId])
}

// ---------------------------------------------------------------------------
// Opportunités, devis, offres, clients, missions
// ---------------------------------------------------------------------------

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

model Opportunity {
  id              String            @id @default(cuid())
  organizationId  String
  leadId          String
  name            String
  estimatedValue  Int
  probability     Int               @default(20)
  status          OpportunityStatus @default(OPEN)
  lostReason      String?
  expectedCloseAt DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  quotes       Quote[]

  @@index([organizationId, status])
  @@index([leadId])
}

enum ServiceKind {
  VIRTUAL_TOUR_SIMPLE
  VIRTUAL_TOUR_PREMIUM
  PHOTO_PACK_AND_TOUR
  MULTI_UNIT_OFFER
  UPDATE_SUBSCRIPTION
  OUT_OF_ZONE_TRAVEL
  CUSTOM
}

model Service {
  id             String      @id @default(cuid())
  organizationId String
  kind           ServiceKind
  name           String
  description    String?
  basePrice      Int
  isActive       Boolean     @default(true)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quoteLines   QuoteLine[]
  invoiceLines InvoiceLine[]

  @@index([organizationId])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

/// Statut de la signature électronique (abstraction, v0.9, ADR 0038) — le
/// brief demande explicitement une ABSTRACTION (contrairement aux emails/
/// Google Calendar, aucun fournisseur réel n'est câblé) : voir
/// `src/lib/quotes/esignature/`.
enum QuoteSignatureStatus {
  NONE
  PENDING
  SIGNED
  DECLINED
}

model Quote {
  id                 String               @id @default(cuid())
  organizationId     String
  leadId             String
  opportunityId      String?
  reference          String
  status             QuoteStatus          @default(DRAFT)
  /// Somme des lignes (quantité × prix unitaire), avant remise et TVA.
  subtotalAmount     Int                  @default(0)
  /// Remise globale du devis, en pourcentage (0-100) — v0.9.
  discountPercent    Float                @default(0)
  /// Taux de TVA appliqué, en pourcentage (ex. 20 pour 20%) — v0.9.
  vatRate            Float                @default(20)
  /// Montant de TVA calculé (sur le montant après remise) — v0.9.
  vatAmount          Int                  @default(0)
  /// Montant total TTC (inchangé depuis avant v0.9 : remise + TVA déjà appliquées).
  totalAmount        Int                  @default(0)
  signatureStatus    QuoteSignatureStatus @default(NONE)
  signedAt           DateTime?
  signerName         String?
  signerEmail        String?
  /// Nom du fournisseur de signature électronique utilisé (ex. "demo") — voir `esignature/types.ts`.
  signatureProvider  String?
  /// Identifiant de la demande côté fournisseur — permet de corréler un futur webhook réel à ce devis.
  signatureRequestId String?
  sentAt             DateTime?
  expiresAt          DateTime?
  acceptedAt         DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunity  Opportunity?   @relation(fields: [opportunityId], references: [id])
  lines        QuoteLine[]
  versions     QuoteVersion[]
  invoices     Invoice[]

  @@unique([organizationId, reference])
  @@index([leadId])
}

model QuoteLine {
  id        String  @id @default(cuid())
  quoteId   String
  serviceId String?
  label     String
  quantity  Int     @default(1)
  unitPrice Int

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id])

  @@index([quoteId])
}

/// Version immuable d'un `Quote` au moment de son envoi (brief v0.9 : "Versionnement") — snapshot
/// JSON des lignes/montants/TVA à cet instant, jamais modifié après création. `Quote` reste la
/// version courante/éditable ; `QuoteVersion` est l'historique figé (extension complète —
/// remise/TVA/PDF/signature électronique — traitée par `src/lib/crm/quote-service.ts`, task #83).
model QuoteVersion {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String?
  quoteId        String
  versionNumber  Int
  snapshot       Json
  totalAmount    Int
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id])
  quote        Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, versionNumber])
  @@index([organizationId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

/// Facture (brief v0.9 : "Transformation en facture") — jamais générée automatiquement depuis un
/// `Quote` : conversion explicite via `src/lib/crm/invoice-service.ts` (task #84) lorsque
/// `Quote.status = ACCEPTED`. Modèle séparé de `Quote` (cycle de vie différent : une facture peut
/// être payée partiellement/en retard, un devis non). Voir ADR 0038.
model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  workspaceId    String?
  leadId         String
  quoteId        String?
  reference      String
  status         InvoiceStatus @default(DRAFT)
  totalAmount    Int           @default(0)
  vatAmount      Int           @default(0)
  sentAt         DateTime?
  dueAt          DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?       @relation(fields: [workspaceId], references: [id])
  lead         Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  quote        Quote?           @relation(fields: [quoteId], references: [id])
  lines        InvoiceLine[]
  virtualTours VirtualTour[]
  payments     InvoicePayment[]

  @@unique([organizationId, reference])
  @@index([leadId])
  @@index([quoteId])
  @@index([workspaceId])
}

/// Paiement partiel ou complet d'une facture (v1.1, AR-0169) — plusieurs paiements possibles par
/// facture ; la somme détermine le statut PAID dès qu'elle atteint `Invoice.totalAmount` (voir
/// `recordInvoicePayment()`). `InvoiceStatus` reste la source de vérité affichée, ce modèle n'est
/// qu'un historique des règlements individuels.
model InvoicePayment {
  id             String   @id @default(cuid())
  organizationId String
  invoiceId      String
  amount         Int
  paidAt         DateTime @default(now())
  method         String
  note           String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([invoiceId])
}

model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceId String
  serviceId String?
  label     String
  quantity  Int     @default(1)
  unitPrice Int
  vatRate   Float   @default(20)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id])

  @@index([invoiceId])
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String   @unique
  wonAt          DateTime @default(now())
  lifetimeValue  Int      @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  missions     Mission[]

  @@index([organizationId])
}

enum MissionStatus {
  PROPOSED
  ACCEPTED
  DECLINED
  IN_PROGRESS
  DELIVERED
  CANCELLED
}

model Mission {
  id             String        @id @default(cuid())
  organizationId String
  customerId     String
  providerId     String?
  territoryId    String?
  title          String
  status         MissionStatus @default(PROPOSED)
  scheduledAt    DateTime?
  deliverables   Json[]        @default([])
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider     Provider?     @relation(fields: [providerId], references: [id])
  territory    Territory?    @relation(fields: [territoryId], references: [id])
  virtualTours VirtualTour[]

  @@index([organizationId, status])
}

// ---------------------------------------------------------------------------
// Automatisation, notifications, conformité, audit
// ---------------------------------------------------------------------------

model AutomationRule {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  triggerType    String
  triggerConfig  Json
  actionType     String
  actionConfig   Json
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String?
  type           String
  title          String
  body           String?
  link           String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, userId])
}

enum NotificationChannel {
  APP
  EMAIL
}

/// Préférences de notification par utilisateur (v1.1, AR-0180) — canal (application/email) x
/// évènement, vérifiées avant émission par `notification.create` (Automation Engine ET Workflow
/// Engine, voir `notification-action.ts` des deux modules). Absence de ligne pour une combinaison
/// (utilisateur, évènement, canal) = activé par défaut (comportement inchangé pour tout
/// utilisateur qui n'a rien configuré) — jamais un opt-in silencieux.
model NotificationPreference {
  id             String              @id @default(cuid())
  organizationId String
  userId         String
  /// Clé d'évènement (ex. "lead.created", "quote.signed", "invoice.paid", "invoice.overdue") — voir `NOTIFICATION_PREFERENCE_EVENTS`.
  eventKey       String
  channel        NotificationChannel
  enabled        Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventKey, channel])
  @@index([organizationId, userId])
}

enum SuppressionReason {
  UNSUBSCRIBED
  BOUNCED
  MANUAL_EXCLUSION
  COMPLAINT
}

model SuppressionEntry {
  id             String            @id @default(cuid())
  organizationId String
  email          String?
  phone          String?
  reason         SuppressionReason
  note           String?
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([organizationId, phone])
}

enum ConsentBasis {
  LEGITIMATE_INTEREST_B2B
  EXPLICIT_CONSENT
  CONTRACT
}

model ConsentRecord {
  id             String       @id @default(cuid())
  organizationId String
  leadId         String?
  email          String?
  basis          ConsentBasis
  note           String?
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  leadId         String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  lead         Lead?         @relation(fields: [leadId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}

enum AIRequestKind {
  ANALYZE_LEAD
  SCORE_RECOMMENDATION
  GENERATE_MESSAGE
  CLASSIFY_REPLY
  SUMMARIZE_CONVERSATION
  RECOMMEND_NEXT_ACTION
  TRANSLATE
  GENERATE_REPORT
  /// Génération narrative du Framework des Agents (`generateAgentNarrative`, v0.9 bis AR-0051) — distincte des types ci-dessus, propres à la couche IA historique `src/lib/ai/`.
  AGENT_NARRATIVE
}

enum AIRequestStatus {
  COMPLETED
  FAILED
  PENDING_VALIDATION
  VALIDATED
  REJECTED
}

model AIRequest {
  id               String          @id @default(cuid())
  organizationId   String
  userId           String?
  leadId           String?
  // Rattache un appel IA déclenché par un agent à son exécution — permet
  // d'agréger le coût IA par run/installation (voir docs/adr/0007 et
  // ROADMAP.md MOD-22). Nul pour tous les appels IA hors Agent Framework
  // (le reste de l'application, inchangé).
  agentRunId       String?
  kind             AIRequestKind
  provider         String
  model            String
  prompt           String
  response         String
  estimatedCostUsd Float           @default(0)
  status           AIRequestStatus @default(COMPLETED)
  createdAt        DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])
  lead         Lead?        @relation(fields: [leadId], references: [id])
  agentRun     AgentRun?    @relation(fields: [agentRunId], references: [id])

  @@index([organizationId, kind])
  @@index([leadId])
  @@index([agentRunId])
}

enum IntegrationKind {
  EMAIL
  AI
  CALENDAR
  DATA_PROVIDER
  /// Canaux du Communication Hub (v0.9, ADR 0038) — additifs, mêmes conventions
  /// `status`/`config` que les valeurs existantes.
  SMS
  WHATSAPP
  PHONE
  WEBHOOK
}

enum IntegrationStatus {
  DEMO
  CONNECTED
  DISCONNECTED
  ERROR
}

model Integration {
  id             String            @id @default(cuid())
  organizationId String
  kind           IntegrationKind
  name           String
  status         IntegrationStatus @default(DEMO)
  config         Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, kind, name])
}

/// Intégrations couvertes par l'écran de diagnostic (v1.2, AR-0165, voir ADR
/// 0045) — distinct d'`IntegrationKind` : Stripe et S3 n'ont pas de ligne
/// `Integration` (configuration par variable d'environnement de déploiement,
/// jamais par organisation), alors que ce diagnostic les couvre quand même.
enum IntegrationDiagnosticKey {
  STRIPE
  TWILIO
  GMAIL
  OUTLOOK
  S3_STORAGE
}

/// États affichés par l'écran de diagnostic (v1.2, AR-0165). `TEST_SUCCESS`/
/// `TEST_FAILED` reflètent le dernier `IntegrationDiagnosticCheck` connu ;
/// `UNAVAILABLE` distingue un service injoignable (réseau/délai dépassé)
/// d'un échec d'authentification/configuration (`TEST_FAILED`).
enum IntegrationDiagnosticStatus {
  NOT_CONFIGURED
  PARTIALLY_CONFIGURED
  CONFIGURED
  TEST_SUCCESS
  TEST_FAILED
  UNAVAILABLE
}

/// Historique des tests de connexion déclenchés manuellement depuis l'écran
/// de diagnostic (v1.2, AR-0165) — sert à la fois d'audit ("qui a testé
/// quoi, quand") et de source du dernier résultat affiché. `message` est
/// TOUJOURS un texte sûr généré côté serveur (code HTTP, nature de l'erreur)
/// — jamais la configuration ou une valeur brute renvoyée par le
/// fournisseur tiers.
model IntegrationDiagnosticCheck {
  id             String                      @id @default(cuid())
  organizationId String
  integration    IntegrationDiagnosticKey
  status         IntegrationDiagnosticStatus
  message        String?
  checkedById    String?
  createdAt      DateTime                    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checkedBy    User?        @relation("IntegrationDiagnosticCheckRunBy", fields: [checkedById], references: [id], onDelete: SetNull)

  @@index([organizationId, integration, createdAt])
}

model WebhookEvent {
  id             String    @id @default(cuid())
  organizationId String?
  source         String
  eventType      String
  payload        Json
  signatureValid Boolean   @default(false)
  processedAt    DateTime?
  createdAt      DateTime  @default(now())
  /// Identifiant de l'évènement chez l'émetteur (ex. `event.id` Stripe) — v1.0, AR-0063. Nullable pour ne rien casser des lignes existantes (aucun webhook entrant réel avant v1.0) ; combiné à `source` pour dédupliquer un évènement livré plusieurs fois par le même émetteur (idempotence).
  externalId     String?

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([source, externalId])
  @@index([organizationId, eventType])
}

// ---------------------------------------------------------------------------
// v1.0 — API publique, webhooks sortants, abonnements SaaS (MOD-18/MOD-19)
// ---------------------------------------------------------------------------

/// Clé API publique par organisation (AR-0059) — le secret complet n'est
/// montré qu'une seule fois à la création ; seul son hash (SHA-256) est
/// conservé, jamais la valeur en clair (même principe que `passwordHash`).
model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  /// Préfixe affichable sans risque dans l'UI (ex. "ak_live_3f9a") — jamais le secret complet.
  keyPrefix      String
  hashedKey      String    @unique
  scopes         String[]  @default(["read"])
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ApiKeyCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId])
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

/// Abonnement d'une organisation à des évènements sortants (AR-0061) — le
/// secret HMAC est TOUJOURS généré automatiquement, jamais optionnel (même
/// principe que `ensureWebhookTriggerConfig`, v0.10 AR-0156).
model WebhookSubscription {
  id             String   @id @default(cuid())
  organizationId String
  url            String
  secret         String
  /// Clés d'évènement du bus applicatif existant (`src/lib/events/domain-events.ts`) auxquelles cette souscription est abonnée — ex. `["lead.created", "quote.signed", "invoice.paid"]`.
  eventTypes     String[]
  isActive       Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?             @relation("WebhookSubscriptionCreatedBy", fields: [createdById], references: [id])
  deliveries   WebhookDelivery[]

  @@index([organizationId])
}

/// Une tentative de livraison d'un évènement à une souscription — `idempotencyKey`
/// est envoyé au récepteur (en-tête `X-Autorun-Delivery-Id`) pour lui permettre
/// de dédupliquer un évènement livré plusieurs fois (ex. après un retry).
model WebhookDelivery {
  id             String                @id @default(cuid())
  subscriptionId String
  organizationId String
  eventType      String
  payload        Json
  idempotencyKey String                @unique
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  responseStatus Int?
  lastError      String?
  nextRetryAt    DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status, nextRetryAt])
}

enum PlanKey {
  TRIAL
  STARTER
  PRO
  ENTERPRISE
}

/// Plan d'abonnement SaaS Autorun (AR-0062, étendu v1.4 AR-0183) — ses quotas
/// sont copiés sur `Organization` quand le plan est (ré)appliqué
/// (`applyPlanToOrganization`), pour réutiliser tel quel tout le code
/// d'application des quotas déjà existant (`sequence-engine.ts`,
/// `src/lib/ai/quota.ts`, `src/lib/email/quota.ts`) sans lui faire connaître
/// la notion de plan.
model Plan {
  id                 String   @id @default(cuid())
  key                PlanKey  @unique
  name               String
  maxUsers           Int
  dailySendLimit     Int
  aiMonthlyBudgetUsd Float?
  /// Exécutions d'automatisation (Automation Engine, v0.8) autorisées par mois glissant (30j) —
  /// `null` = illimité (v1.4, AR-0183). Vérifié par `src/lib/billing/quota-enforcement.ts` à
  /// chaque création de `AutomationRun` (`createAutomationRun`), jamais au niveau du job
  /// individuel (un run peut produire plusieurs jobs — la limite porte sur le déclenchement,
  /// pas sur le travail interne).
  maxAutomationRuns  Int?
  /// Stockage total (pièces jointes, `Attachment.sizeBytes`) autorisé en mégaoctets — `null` =
  /// illimité (v1.4, AR-0183). Vérifié à l'upload (`src/app/api/attachments/upload/route.ts`).
  maxStorageMb       Int?
  /// Connecteurs tiers configurés (`Integration` avec `status != DEMO`) autorisés simultanément —
  /// `null` = illimité (v1.4, AR-0183).
  maxConnectors      Int?
  /// Prix mensuel en centimes (informatif, affichage UI).
  priceMonthlyUsd    Int
  /// Identifiant du Price Stripe correspondant — requis seulement en mode `BILLING_PROVIDER=stripe`.
  stripePriceId      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organizations Organization[]
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  /// Écriture bloquée, lecture toujours possible — jamais de perte de données (voir `MILESTONES.md` §v1.0).
  RESTRICTED
}

// ---------------------------------------------------------------------------
// Agent Framework (v0.3) — infrastructure uniquement, aucun agent métier.
// Voir docs/adr/0007, 0008, 0009 et docs/02-ARCHITECTURE.md §10.
// Étendu en v0.4 par l'Agent Director (orchestration, voir plus bas dans ce
// même fichier) — toujours aucun agent métier réel.
// ---------------------------------------------------------------------------

enum AgentDefinitionStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
  ARCHIVED
}

/// Catalogue des agents disponibles (le "quoi"). organizationId nul = agent
/// global fourni par Autorun ; non nul = agent propre à une organisation
/// (préparé pour des agents personnalisés futurs). Aucune logique
/// exécutable ici : `runtimeKey` référence l'implémentation TypeScript
/// (src/lib/agents/registry.ts).
model AgentDefinition {
  id                  String                @id @default(cuid())
  organizationId      String?
  key                 String
  name                String
  description         String?
  version             String                @default("0.1.0")
  status              AgentDefinitionStatus @default(DRAFT)
  author              String
  category            String
  icon                String?
  runtimeKey          String
  configSchema        Json?
  declaredToolKeys    String[]              @default([])
  declaredPermissions String[]              @default([])
  compatibleAiModels  String[]              @default([])
  defaultLimits       Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  organization  Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  installations AgentInstallation[]

  @@unique([organizationId, key])
  @@index([status])
  @@index([category])
}

enum AgentInstallationStatus {
  INSTALLED
  ACTIVE
  INACTIVE
  SUSPENDED
  UNINSTALLED
}

/// L'installation d'une AgentDefinition dans UN workspace (le "où" et le
/// "avec quels droits"). Tout ce qui découle d'un agent (exécutions,
/// mémoire, messages, planification) référence une AgentInstallation,
/// jamais directement une AgentDefinition — garantit l'isolation
/// multi-tenant dès le modèle de données (voir ADR 0007).
model AgentInstallation {
  id                 String                  @id @default(cuid())
  organizationId     String
  workspaceId        String
  definitionId       String
  status             AgentInstallationStatus @default(INSTALLED)
  config             Json?
  grantedToolKeys    String[]                @default([])
  grantedPermissions String[]                @default([])
  usageLimits        Json?
  installedById      String?
  installedAt        DateTime                @default(now())
  uninstalledAt      DateTime?
  suspendedAt        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  definition   AgentDefinition @relation(fields: [definitionId], references: [id])
  installedBy  User?           @relation("AgentInstalledBy", fields: [installedById], references: [id])

  runs                 AgentRun[]
  memoryEntries        AgentMemoryEntry[]
  schedules            AgentSchedule[]
  messagesFrom         AgentMessage[]             @relation("AgentMessageFrom")
  messagesTo           AgentMessage[]             @relation("AgentMessageTo")
  interventionRequests AgentInterventionRequest[]
  plans                AgentPlan[]
  planStepsAsTarget    AgentPlanStep[]            @relation("AgentPlanStepTarget")
  commercialProspects  CommercialProspect[]
  commercialActions    CommercialAction[]

  @@unique([workspaceId, definitionId])
  @@index([organizationId])
  @@index([workspaceId, status])
}

/// Registre déclaratif des outils qu'un agent peut se voir accorder.
/// Une ligne par outil ; l'implémentation réelle (le code appelé) vit dans
/// src/lib/agents/tool-registry.ts et est référencée par `key`.
model AgentTool {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  description  String?
  category     String
  inputSchema  Json?
  outputSchema Json?
  isBuiltIn    Boolean  @default(true)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  TIMED_OUT
}

enum AgentRunTrigger {
  MANUAL
  SCHEDULED
  EVENT
  API
  /// Exécution créée par délégation d'un autre agent (voir v0.4, Agent
  /// Director) — distincte de MANUAL (humain) et API (appelant externe).
  AGENT
}

/// Une exécution d'agent. File d'attente interne sur PostgreSQL (voir ADR
/// 0008) : `status=QUEUED` + `scheduledAt` jouent le rôle de file, traitée
/// par `processQueuedAgentRuns` (src/lib/agents/execution-engine.ts).
model AgentRun {
  id             String          @id @default(cuid())
  installationId String
  status         AgentRunStatus  @default(QUEUED)
  trigger        AgentRunTrigger @default(MANUAL)
  priority       Int             @default(0)
  input          Json?
  output         Json?
  error          Json?
  attempt        Int             @default(0)
  maxAttempts    Int             @default(1)
  timeoutMs      Int             @default(30000)
  scheduledAt    DateTime        @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  cancelledAt    DateTime?
  parentRunId    String?
  createdById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  installation AgentInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  parentRun    AgentRun?         @relation("AgentRunRetry", fields: [parentRunId], references: [id])
  retries      AgentRun[]        @relation("AgentRunRetry")
  createdBy    User?             @relation("AgentRunCreatedBy", fields: [createdById], references: [id])

  logs                 AgentRunLog[]
  aiRequests           AIRequest[]
  messages             AgentMessage[]
  interventionRequests AgentInterventionRequest[]
  directorPlan         AgentPlan?                 @relation("AgentPlanOwnerRun")
  planStep             AgentPlanStep?             @relation("AgentPlanStepSubRun")

  @@index([installationId, status])
  @@index([status, scheduledAt])
}

/// Journal d'exécution consultable depuis l'UI (distinct des logs pino
/// applicatifs, qui ne sont pas requêtables depuis l'interface).
model AgentRunLog {
  id        String   @id @default(cuid())
  runId     String
  level     String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

enum AgentMemoryScope {
  SHORT_TERM
  PERSISTENT
  SHARED
}

/// Mémoire d'agent à trois portées (voir ADR 0009) : SHORT_TERM/PERSISTENT
/// scopées à une installation, SHARED scopée au workspace
/// (installationId nul). `embedding` réservé pour une vectorisation
/// future, jamais renseigné par le code actuel. L'unicité par
/// (portée, clé) est appliquée côté application (src/lib/agents/memory.ts,
/// seul point d'écriture), pas par contrainte SQL — une contrainte unique
/// classique ne peut pas distinguer plusieurs lignes SHARED dont
/// installationId est NULL (NULL n'est jamais égal à NULL en SQL).
model AgentMemoryEntry {
  id             String           @id @default(cuid())
  workspaceId    String
  installationId String?
  scope          AgentMemoryScope
  key            String
  value          Json
  embedding      Json?
  expiresAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installation AgentInstallation? @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@index([workspaceId, scope, key])
  @@index([installationId, scope, key])
  @@index([expiresAt])
}

enum AgentMessageType {
  TASK_REQUEST
  TASK_RESPONSE
  RESULT
  ERROR
  INTERVENTION_REQUEST
  INFO
}

enum AgentMessageStatus {
  PENDING
  DELIVERED
  READ
  ACTIONED
}

/// Communication inter-agents et agent<->humain, systématiquement
/// historisée (jamais de mutation/suppression, uniquement des lignes
/// nouvelles + changement de `status`).
model AgentMessage {
  id                 String             @id @default(cuid())
  workspaceId        String
  fromInstallationId String?
  toInstallationId   String?
  runId              String?
  type               AgentMessageType
  status             AgentMessageStatus @default(PENDING)
  payload            Json
  createdAt          DateTime           @default(now())
  deliveredAt        DateTime?
  readAt             DateTime?

  workspace           Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fromInstallation    AgentInstallation?        @relation("AgentMessageFrom", fields: [fromInstallationId], references: [id])
  toInstallation      AgentInstallation?        @relation("AgentMessageTo", fields: [toInstallationId], references: [id])
  run                 AgentRun?                 @relation(fields: [runId], references: [id])
  interventionRequest AgentInterventionRequest?

  @@index([workspaceId, createdAt])
  @@index([toInstallationId])
  @@index([fromInstallationId])
}

enum AgentInterventionStatus {
  PENDING
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

/// Demande d'intervention humaine ("human in the loop"), typiquement créée
/// à partir d'un AgentMessage de type INTERVENTION_REQUEST.
model AgentInterventionRequest {
  id               String                  @id @default(cuid())
  workspaceId      String
  installationId   String
  runId            String?
  messageId        String?                 @unique
  title            String
  description      String?
  status           AgentInterventionStatus @default(PENDING)
  assignedToUserId String?
  resolvedById     String?
  resolvedAt       DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installation AgentInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  run          AgentRun?         @relation(fields: [runId], references: [id])
  message      AgentMessage?     @relation(fields: [messageId], references: [id])
  assignedTo   User?             @relation("AgentInterventionAssignedTo", fields: [assignedToUserId], references: [id])
  resolvedBy   User?             @relation("AgentInterventionResolvedBy", fields: [resolvedById], references: [id])

  @@index([workspaceId, status])
}

enum AgentScheduleKind {
  ONE_OFF
  RECURRING
  EVENT
}

/// Planification des exécutions : ponctuelle (runAt), récurrente
/// (cronExpression), ou déclenchée par un évènement applicatif
/// (eventKey — ex. "lead.qualified"), traitée par
/// processDueAgentSchedules (src/lib/agents/scheduler.ts).
model AgentSchedule {
  id             String            @id @default(cuid())
  installationId String
  kind           AgentScheduleKind
  cronExpression String?
  runAt          DateTime?
  eventKey       String?
  input          Json?
  isActive       Boolean           @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  installation AgentInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@index([installationId])
  @@index([isActive, nextRunAt])
}

// ---------------------------------------------------------------------------
// Agent Director — orchestration (v0.4). Le Director est un agent comme les
// autres (AgentDefinition + AgentInstallation, exécuté par le même moteur
// d'exécution) ; ces deux modèles ajoutent uniquement la structure d'un plan
// d'exécution multi-étapes qu'un agent orchestrateur peut produire et piloter.
// Voir docs/adr/0010, 0011, 0012 et docs/02-ARCHITECTURE.md §11.
// ---------------------------------------------------------------------------

enum AgentPlanStatus {
  DRAFT
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AgentPlanStepStatus {
  PENDING
  READY
  DELEGATED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  CANCELLED
}

/// Plan d'exécution généré par un agent orchestrateur (le Director, dans
/// cette version) en réponse à une demande. `installationId` est toujours
/// l'installation orchestratrice propriétaire du plan — jamais celle d'un
/// agent délégué (voir `AgentPlanStep.targetInstallationId`). `runId`
/// référence l'AgentRun du Director qui a produit ce plan (1:1).
model AgentPlan {
  id             String          @id @default(cuid())
  workspaceId    String
  installationId String
  runId          String?         @unique
  goal           String
  status         AgentPlanStatus @default(DRAFT)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  startedAt      DateTime?
  finishedAt     DateTime?

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installation AgentInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  run          AgentRun?         @relation("AgentPlanOwnerRun", fields: [runId], references: [id])
  steps        AgentPlanStep[]

  @@index([workspaceId, status])
  @@index([installationId])
}

/// Une étape d'un plan d'exécution. `targetInstallationId` est résolu soit
/// explicitement (fourni à la création du plan), soit dynamiquement au
/// moment de la délégation à partir de `targetCategory` (voir
/// `src/lib/agents/director/delegation-engine.ts`) — les deux champs
/// peuvent coexister le temps de la résolution. `dependsOnStepIds`
/// référence d'autres `AgentPlanStep.id` du même plan ; seules des
/// références vers des étapes d'index strictement inférieur sont acceptées
/// à la création (voir `planning-engine.ts`), ce qui exclut trivialement
/// tout cycle. `subRunId` référence l'AgentRun réellement créé pour
/// l'agent délégué (1:1, `null` tant que l'étape n'a pas été déléguée).
model AgentPlanStep {
  id                   String              @id @default(cuid())
  planId               String
  stepIndex            Int
  objective            String
  targetInstallationId String?
  targetCategory       String?
  priority             Int                 @default(0)
  dependsOnStepIds     String[]            @default([])
  requiredToolKeys     String[]            @default([])
  requiredPermissions  String[]            @default([])
  input                Json?
  status               AgentPlanStepStatus @default(PENDING)
  subRunId             String?             @unique
  startedAt            DateTime?
  finishedAt           DateTime?
  durationMs           Int?
  result               Json?
  error                Json?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  plan               AgentPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  targetInstallation AgentInstallation? @relation("AgentPlanStepTarget", fields: [targetInstallationId], references: [id])
  subRun             AgentRun?          @relation("AgentPlanStepSubRun", fields: [subRunId], references: [id])

  @@index([planId, stepIndex])
  @@index([targetInstallationId])
}

// ---------------------------------------------------------------------------
// Agent Commercial (v0.5) — premier agent MÉTIER d'Autorun, construit
// intégralement sur le Framework des Agents (v0.3) et l'Agent Director
// (v0.4) : aucune table ici ne remplace `AgentInstallation`/`AgentRun`, elle
// les complète. `CommercialProspect`/`CommercialAction` sont volontairement
// distincts du `Lead`/`Opportunity`/`Quote` de Provence 360 (spécifiques au
// vertical photographie 360°, jamais généralisés — voir MOD-02, toujours
// reporté) : le Commercial doit rester un agent générique, réutilisable par
// n'importe quel futur vertical, pas câblé sur les catégories Provence 360.
// Voir docs/adr/0014 et docs/02-ARCHITECTURE.md §12.
// ---------------------------------------------------------------------------

enum CommercialStage {
  NEW
  TO_QUALIFY
  QUALIFIED
  FIRST_CONTACT
  FOLLOW_UP
  MEETING
  QUOTE_SENT
  NEGOTIATION
  WON
  LOST
}

/// Fiche prospect gérée par une installation de l'Agent Commercial.
/// `installationId` est toujours requis : un prospect appartient à
/// l'installation qui le gère (même principe que `AgentMemoryEntry`
/// scopée à une installation) — jamais une table globale non rattachée au
/// Framework.
model CommercialProspect {
  id                 String          @id @default(cuid())
  organizationId     String
  workspaceId        String
  installationId     String
  companyName        String
  sector             String?
  companySize        String?
  website            String?
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  stage              CommercialStage @default(NEW)
  score              Int?
  scoreBreakdown     Json?
  potentialEstimate  Json?
  qualificationNotes String?
  source             String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installation AgentInstallation  @relation(fields: [installationId], references: [id], onDelete: Cascade)
  actions      CommercialAction[]

  @@index([workspaceId, stage])
  @@index([installationId])
}

enum CommercialActionType {
  EMAIL_DRAFT
  FOLLOW_UP
  QUOTE_DRAFT
  PROPOSAL
  RECOMMENDATION
}

enum CommercialActionStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
  DISMISSED
}

/// Action proposée par l'Agent Commercial sur un prospect (email, relance,
/// devis, proposition, recommandation) — un seul modèle générique plutôt
/// qu'une table par type, pour rester facilement extensible (un nouveau
/// type d'action = une valeur d'enum, jamais une nouvelle table) et pour
/// que le système d'approbation soit uniforme (voir ADR 0017). Toujours
/// créée `PENDING_APPROVAL` sauf mode autonome explicitement activé
/// (`AgentInstallation.config.autonomousMode`, désactivé par défaut).
model CommercialAction {
  id             String                 @id @default(cuid())
  organizationId String
  workspaceId    String
  prospectId     String
  installationId String
  type           CommercialActionType
  status         CommercialActionStatus @default(PENDING_APPROVAL)
  title          String
  payload        Json
  reasoning      String?
  autoApproved   Boolean                @default(false)
  createdAt      DateTime               @default(now())
  decidedById    String?
  decidedAt      DateTime?
  sentAt         DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  prospect     CommercialProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  installation AgentInstallation  @relation(fields: [installationId], references: [id], onDelete: Cascade)
  decidedBy    User?              @relation("CommercialActionDecidedBy", fields: [decidedById], references: [id])

  @@index([workspaceId, status])
  @@index([prospectId])
}

/// Moteur de prompts (v0.5, étendu v0.7 — voir ADR 0028) : générique,
/// utilisable par n'importe quel agent. Chaque prompt est versionné
/// (`@@unique([key, version, locale])`), modifiable sans redéploiement
/// (nouvelle version en base), documenté (`description`), séparé du code.
/// `locale` rend un prompt multilingue (plusieurs variantes d'une même
/// version) ; `parentKey` permet l'héritage (un prompt hérite des
/// variables/instructions d'un prompt parent, résolu à l'affichage) ;
/// `variableSchema` type chaque variable déclarée (validée avant rendu).
model PromptTemplate {
  id             String   @id @default(cuid())
  key            String
  version        Int
  locale         String   @default("fr")
  parentKey      String?
  name           String
  description    String?
  category       String
  template       String
  variables      String[] @default([])
  variableSchema Json?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  createdById    String?

  createdBy User? @relation("PromptTemplateCreatedBy", fields: [createdById], references: [id])

  @@unique([key, version, locale])
  @@index([key, locale, isActive])
}

// ---------------------------------------------------------------------------
// Workflow Engine (v0.6) — moteur d'automatisation générique d'Autorun.
// Aucune automatisation métier n'est codée en dur ici : un workflow ne
// référence que des clés déclaratives (déclencheurs/conditions/actions)
// résolues au démarrage par les registres de src/lib/workflows/*/registry.ts,
// exactement comme AgentDefinition.runtimeKey ne contient jamais de code
// exécutable (voir ADR 0007, réappliqué ici — voir ADR 0018). Distinct du
// mécanisme `AutomationRule`/`automation-engine.ts` (v0.1, spécifique au
// vertical photographie 360°, laissé tel quel — voir ADR 0022) : c'est le
// chemin que toute automatisation FUTURE doit emprunter.
// ---------------------------------------------------------------------------

enum WorkflowDefinitionStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// Identité stable d'un workflow (le "quoi"), versionnée séparément (voir
/// WorkflowVersion) — même séparation identité/version que PromptTemplate
/// (v0.5), avec en plus un cycle de vie explicite. `organizationId`/
/// `workspaceId` nuls = modèle global fourni par Autorun (catalogue de
/// templates, jamais déclenché directement — doit d'abord être cloné dans
/// un workspace via `cloneWorkflowDefinition`, même convention que
/// `AgentDefinition`). `activeVersionId` référence la version qui pilote
/// réellement les déclenchements (`WorkflowTriggerBinding`) ; les autres
/// versions restent consultables (historique, rollback) mais inertes.
model WorkflowDefinition {
  id                String                   @id @default(cuid())
  organizationId    String?
  workspaceId       String?
  key               String
  name              String
  description       String?
  category          String
  status            WorkflowDefinitionStatus @default(DRAFT)
  isTemplate        Boolean                  @default(false)
  sourceTemplateKey String?
  activeVersionId   String?                  @unique
  createdById       String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  archivedAt        DateTime?

  organization  Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace     Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy     User?            @relation("WorkflowDefinitionCreatedBy", fields: [createdById], references: [id])
  activeVersion WorkflowVersion? @relation("WorkflowDefinitionActiveVersion", fields: [activeVersionId], references: [id])

  versions        WorkflowVersion[]        @relation("WorkflowVersionOwner")
  runs            WorkflowRun[]
  triggerBindings WorkflowTriggerBinding[]

  @@unique([workspaceId, key])
  @@index([organizationId])
  @@index([workspaceId, status])
  @@index([isTemplate])
}

/// Un graphe de noeuds/arêtes versionné et immuable une fois créé — on ne
/// modifie jamais une version en place, on en crée une nouvelle (même
/// principe que PromptTemplate). `graph` (voir
/// src/lib/workflows/graph-types.ts pour la forme TypeScript) ne contient
/// que des références déclaratives à des clés enregistrées au registre —
/// jamais de code exécutable.
model WorkflowVersion {
  id                   String   @id @default(cuid())
  workflowDefinitionId String
  version              Int
  graph                Json
  changelog            String?
  createdById          String?
  createdAt            DateTime @default(now())

  workflowDefinition WorkflowDefinition       @relation("WorkflowVersionOwner", fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  createdBy          User?                    @relation("WorkflowVersionCreatedBy", fields: [createdById], references: [id])
  activeFor          WorkflowDefinition?      @relation("WorkflowDefinitionActiveVersion")
  runs               WorkflowRun[]
  triggerBindings    WorkflowTriggerBinding[]

  @@unique([workflowDefinitionId, version])
}

/// Index des noeuds "déclencheur" extraits du graphe à l'activation d'une
/// version (voir workflow-service.ts#activateWorkflowVersion), pour
/// résoudre rapidement "quels workflows écoutent cet évènement / ce cron /
/// ce webhook" sans charger et parser le JSON de chaque graphe à chaque
/// évènement applicatif — même motivation que `AgentSchedule` pour les
/// agents (v0.3).
model WorkflowTriggerBinding {
  id                   String   @id @default(cuid())
  workflowDefinitionId String
  workflowVersionId    String
  workspaceId          String
  nodeId               String
  triggerKey           String
  config               Json?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())

  workflowDefinition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  workflowVersion    WorkflowVersion    @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, triggerKey, isActive])
  @@index([workflowDefinitionId])
}

enum WorkflowRunStatus {
  QUEUED
  RUNNING
  WAITING
  SUCCEEDED
  FAILED
  CANCELLED
  TIMED_OUT
}

enum WorkflowRunTrigger {
  MANUAL
  SCHEDULED
  EVENT
  WEBHOOK
  API
  /// Créée par un autre workflow (noeud "sous-workflow") — distincte de
  /// AGENT (créée par un agent, ex. escalade) et de MANUAL/API.
  WORKFLOW
  AGENT
}

/// Une exécution de workflow. File d'attente interne sur PostgreSQL, même
/// principe que `AgentRun` (voir ADR 0008, réappliqué ici — voir ADR 0018) :
/// `status=QUEUED` + `scheduledAt` jouent le rôle de file (voir
/// `processQueuedWorkflowRuns`), `status=WAITING` + `resumeAt` pour les
/// noeuds d'attente/délai (voir `processDueWorkflowWaits`). Ré-entrant :
/// une exécution peut être interrompue (attente, redémarrage serveur) et
/// reprise plus tard en ne rejouant que les étapes non terminales — la
/// progression réelle vit toujours dans `WorkflowRunStep`, jamais dans un
/// état en mémoire du moteur.
model WorkflowRun {
  id                   String             @id @default(cuid())
  organizationId       String
  workspaceId          String
  workflowDefinitionId String
  workflowVersionId    String
  status               WorkflowRunStatus  @default(QUEUED)
  trigger              WorkflowRunTrigger @default(MANUAL)
  triggerKey           String?
  priority             Int                @default(0)
  input                Json?
  context              Json?
  output               Json?
  error                Json?
  escalatedToDirector  Boolean            @default(false)
  attempt              Int                @default(0)
  maxAttempts          Int                @default(1)
  scheduledAt          DateTime           @default(now())
  resumeAt             DateTime?
  startedAt            DateTime?
  finishedAt           DateTime?
  cancelledAt          DateTime?
  parentRunId          String?
  createdById          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflowDefinition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  workflowVersion    WorkflowVersion    @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  parentRun          WorkflowRun?       @relation("WorkflowRunRetry", fields: [parentRunId], references: [id])
  retries            WorkflowRun[]      @relation("WorkflowRunRetry")
  createdBy          User?              @relation("WorkflowRunCreatedBy", fields: [createdById], references: [id])

  steps WorkflowRunStep[]
  logs  WorkflowRunLog[]

  @@index([workflowDefinitionId, status])
  @@index([workspaceId, status])
  @@index([status, scheduledAt])
  @@index([status, resumeAt])
}

enum WorkflowStepStatus {
  PENDING
  RUNNING
  WAITING
  SUCCEEDED
  FAILED
  SKIPPED
  CANCELLED
  /// Une compensation (rollback logique) a été exécutée pour cette étape
  /// suite à l'échec d'une étape ultérieure du même run.
  COMPENSATED
}

/// Statut d'un noeud du graphe pour UNE exécution donnée — source de
/// vérité de la progression (voir `WorkflowRun`). `nodeId` référence
/// l'identifiant du noeud dans `WorkflowVersion.graph`, jamais une clé
/// primaire SQL (le graphe n'est pas normalisé en tables).
model WorkflowRunStep {
  id         String             @id @default(cuid())
  runId      String
  nodeId     String
  nodeType   String
  actionKey  String?
  status     WorkflowStepStatus @default(PENDING)
  attempt    Int                @default(0)
  input      Json?
  output     Json?
  error      Json?
  startedAt  DateTime?
  finishedAt DateTime?
  durationMs Int?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, nodeId])
  @@index([runId, status])
}

/// Journal d'exécution consultable depuis l'UI (même rôle que
/// `AgentRunLog`).
model WorkflowRunLog {
  id        String   @id @default(cuid())
  runId     String
  nodeId    String?
  level     String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

// ---------------------------------------------------------------------------
// Système d'intelligence documentaire (v0.7) — Memory Engine, Knowledge
// Engine, Context Engine (le Prompt Engine est étendu ci-dessus sur le
// modèle PromptTemplate existant, pas dupliqué). Aucun agent ne gère sa
// propre mémoire ou son contexte : tout passe par cette couche. Voir
// docs/adr/0023 à 0029 et docs/02-ARCHITECTURE.md §14.
//
// `AgentMemoryEntry` (v0.3) n'est ni supprimé ni migré dans cette phase
// (Director/Commercial en dépendent tel quel) — voir ADR 0023 : le
// `MemoryEntry` générique ci-dessous est la couche que tout nouveau code
// doit utiliser.
// ---------------------------------------------------------------------------

enum MemoryScopeType {
  USER
  ORGANIZATION
  WORKSPACE
  AGENT
  WORKFLOW
  CONVERSATION
  TASK
}

enum MemoryKind {
  LONG_TERM
  TEMPORARY
  DECISION
  DOCUMENT
  PREFERENCE
}

/// Mémoire générique multi-niveaux (Memory Engine). `scopeId` est
/// polymorphe (id d'un User/Organization/Workspace/AgentInstallation/
/// WorkflowDefinition/conversation/tâche selon `scopeType`), jamais une
/// clé étrangère SQL — les portées sont trop hétérogènes pour une seule
/// relation. Versionné comme `PromptTemplate` : une nouvelle version est
/// toujours créée par `setMemoryEntry`, jamais de modification en place ;
/// `isCurrent` marque la version active par (scope, clé). `summary`/
/// `compressed` portent le résultat d'une compression automatique (voir
/// `memory-engine.ts#compressMemoryEntry`, réutilise le moteur LLM v0.5).
model MemoryEntry {
  id             String          @id @default(cuid())
  organizationId String
  workspaceId    String?
  scopeType      MemoryScopeType
  scopeId        String
  kind           MemoryKind
  key            String
  version        Int             @default(1)
  isCurrent      Boolean         @default(true)
  value          Json
  summary        String?
  compressed     Boolean         @default(false)
  ttlMs          Int?
  expiresAt      DateTime?
  archivedAt     DateTime?
  createdById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("MemoryEntryCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, scopeType, scopeId, key, isCurrent])
  @@index([expiresAt])
  @@index([archivedAt])
}

enum KnowledgeSourceType {
  PDF
  WORD
  EXCEL
  POWERPOINT
  MARKDOWN
  HTML
  EMAIL
  NOTE
  CRM
  QUOTE
  INVOICE
  CONVERSATION
  LOG
  DECISION
  WORKFLOW
  DOCUMENTATION
  IMAGE
  AUDIO
  VIDEO
}

enum KnowledgeDocumentStatus {
  PENDING
  INDEXED
  FAILED
  ARCHIVED
}

/// Base de connaissances (Knowledge Engine). Un document par source
/// ingérée (fichier, enregistrement CRM, conversation, log, décision,
/// workflow...), toujours scopé organisation + workspace — jamais
/// accessible sans cette double portée (voir ADR 0026, sécurité).
/// `checksum` permet la détection de changement pour la réindexation
/// incrémentale (voir `indexing-engine.ts`). `sourceRef` référence
/// l'identifiant de la source d'origine (id de prospect, chemin de
/// fichier...) quand pertinent, pour éviter les doublons à ré-ingestion.
model KnowledgeDocument {
  id             String                  @id @default(cuid())
  organizationId String
  workspaceId    String
  sourceType     KnowledgeSourceType
  sourceRef      String?
  title          String
  content        String?
  metadata       Json?
  tags           String[]                @default([])
  checksum       String?
  status         KnowledgeDocumentStatus @default(PENDING)
  errorMessage   String?
  usageCount     Int                     @default(0)
  lastUsedAt     DateTime?
  createdById    String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  indexedAt      DateTime?
  archivedAt     DateTime?

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User?               @relation("KnowledgeDocumentCreatedBy", fields: [createdById], references: [id])
  chunks       KnowledgeChunk[]
  indexLogs    KnowledgeIndexLog[]

  @@unique([workspaceId, sourceType, sourceRef])
  @@index([organizationId, workspaceId, status])
  @@index([organizationId, workspaceId, sourceType])
}

/// Un fragment indexable d'un document, avec son embedding. Stocké en
/// tableau de flottants Postgres natif (pas une colonne `vector`) : aucune
/// extension pgvector n'est disponible dans cet environnement — repli
/// portable documenté (similarité cosinus calculée côté application), voir
/// ADR 0025. `embeddingModel` trace quel modèle a produit le vecteur, pour
/// ne jamais comparer deux embeddings de dimensions/modèles différents.
model KnowledgeChunk {
  id             String   @id @default(cuid())
  documentId     String
  chunkIndex     Int
  content        String
  tokenCount     Int?
  embedding      Float[]  @default([])
  embeddingModel String?
  createdAt      DateTime @default(now())

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
}

enum KnowledgeIndexAction {
  ADD
  UPDATE
  DELETE
  RENAME
  MOVE
  REINDEX
}

/// Journal de l'indexation (voir `indexing-engine.ts`) : chaque opération
/// (ajout/mise à jour/suppression/renommage/déplacement/réindexation) est
/// historisée, avec sa priorité et sa durée, qu'elle ait réussi ou échoué.
model KnowledgeIndexLog {
  id          String               @id @default(cuid())
  documentId  String?
  workspaceId String
  action      KnowledgeIndexAction
  priority    Int                  @default(0)
  success     Boolean              @default(true)
  message     String?
  durationMs  Int?
  createdAt   DateTime             @default(now())

  document KnowledgeDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([documentId])
}

/// Journal des appels au moteur d'embeddings (coût, cache, version du
/// modèle) — même rôle que `AIRequest` pour le moteur LLM (v0.5), mais
/// distinct : un embedding n'est jamais un texte de réponse, il ne
/// s'intègre pas proprement au même modèle.
model EmbeddingRequest {
  id               String   @id @default(cuid())
  organizationId   String
  workspaceId      String?
  provider         String
  model            String
  inputCount       Int
  dimensions       Int?
  estimatedCostUsd Float    @default(0)
  cached           Boolean  @default(false)
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([organizationId, provider])
}

// ---------------------------------------------------------------------------
// Automation Engine Enterprise (v0.8) — voir docs/adr/0030 à 0037 et
// docs/02-ARCHITECTURE.md §15. Coexiste avec le Workflow Engine (v0.6, non
// modifié) : voir ADR 0030 pour la justification de la frontière entre les
// deux. `Automation`/`AutomationVersion`/`AutomationTriggerBinding`
// reprennent volontairement la même forme que `WorkflowDefinition`/
// `WorkflowVersion`/`WorkflowTriggerBinding` (identité/version séparées,
// registres déclaratifs) — un graphe déclaratif de plus, mais dont
// l'exécution de chaque noeud passe par un vrai noyau de jobs durable
// (`AutomationJob`), pas un simple tick en mémoire : c'est la différence
// entre les deux moteurs (voir ADR 0031). `AutomationJob` sert aussi de
// point d'entrée générique pour n'importe quel module (agents, workflows,
// Knowledge Engine...) qui veut une exécution avec retry/verrou/
// concurrence/priorité/DLQ sans jamais passer par un graphe.
// ---------------------------------------------------------------------------

enum AutomationDefinitionStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// Identité stable d'une automatisation — voir `WorkflowDefinition` pour la
/// justification de la séparation identité/version, reprise ici à
/// l'identique.
model Automation {
  id                String                     @id @default(cuid())
  organizationId    String?
  workspaceId       String?
  key               String
  name              String
  description       String?
  category          String
  status            AutomationDefinitionStatus @default(DRAFT)
  isTemplate        Boolean                    @default(false)
  sourceTemplateKey String?
  activeVersionId   String?                    @unique
  createdById       String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  archivedAt        DateTime?

  organization  Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace     Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy     User?              @relation("AutomationCreatedBy", fields: [createdById], references: [id])
  activeVersion AutomationVersion? @relation("AutomationActiveVersion", fields: [activeVersionId], references: [id])

  versions        AutomationVersion[]        @relation("AutomationVersionOwner")
  runs            AutomationRun[]
  jobs            AutomationJob[]
  triggerBindings AutomationTriggerBinding[]
  circuitBreakers AutomationCircuitBreaker[]

  @@unique([workspaceId, key])
  @@index([organizationId])
  @@index([workspaceId, status])
  @@index([isTemplate])
}

/// Graphe versionné et immuable une fois créé (voir `src/lib/automation/graph-types.ts`)
/// — mêmes principes que `WorkflowVersion` : jamais modifié en place, une
/// nouvelle version est toujours créée.
model AutomationVersion {
  id           String   @id @default(cuid())
  automationId String
  version      Int
  graph        Json
  changelog    String?
  createdById  String?
  createdAt    DateTime @default(now())

  automation      Automation                 @relation("AutomationVersionOwner", fields: [automationId], references: [id], onDelete: Cascade)
  createdBy       User?                      @relation("AutomationVersionCreatedBy", fields: [createdById], references: [id])
  activeFor       Automation?                @relation("AutomationActiveVersion")
  runs            AutomationRun[]
  triggerBindings AutomationTriggerBinding[]

  @@unique([automationId, version])
}

/// Index des noeuds "déclencheur" extraits du graphe à l'activation d'une
/// version — même rôle que `WorkflowTriggerBinding`.
model AutomationTriggerBinding {
  id                  String   @id @default(cuid())
  automationId        String
  automationVersionId String
  workspaceId         String
  nodeId              String
  triggerKey          String
  config              Json?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())

  automation        Automation        @relation(fields: [automationId], references: [id], onDelete: Cascade)
  automationVersion AutomationVersion @relation(fields: [automationVersionId], references: [id], onDelete: Cascade)
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, triggerKey, isActive])
  @@index([automationId])
}

enum AutomationRunStatus {
  QUEUED
  RUNNING
  WAITING
  SUCCEEDED
  FAILED
  CANCELLED
  TIMED_OUT
}

enum AutomationRunTrigger {
  MANUAL
  SCHEDULED
  EVENT
  WEBHOOK
  API
  /// Créée par une autre automatisation (noeud "fork"/"sous-automatisation").
  AUTOMATION
}

/// Une exécution d'automatisation : orchestre le graphe noeud par noeud,
/// exactement comme `WorkflowRun` — la différence tient à l'exécution de
/// CHAQUE noeud, qui passe par un `AutomationJob` durable (voir plus bas)
/// plutôt que par un simple appel en mémoire (voir ADR 0031).
model AutomationRun {
  id                  String               @id @default(cuid())
  organizationId      String
  workspaceId         String
  automationId        String
  automationVersionId String
  status              AutomationRunStatus  @default(QUEUED)
  trigger             AutomationRunTrigger @default(MANUAL)
  triggerKey          String?
  priority            Int                  @default(0)
  input               Json?
  context             Json?
  output              Json?
  error               Json?
  attempt             Int                  @default(0)
  maxAttempts         Int                  @default(1)
  scheduledAt         DateTime             @default(now())
  resumeAt            DateTime?
  startedAt           DateTime?
  finishedAt          DateTime?
  cancelledAt         DateTime?
  parentRunId         String?
  createdById         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation        Automation        @relation(fields: [automationId], references: [id], onDelete: Cascade)
  automationVersion AutomationVersion @relation(fields: [automationVersionId], references: [id], onDelete: Cascade)
  parentRun         AutomationRun?    @relation("AutomationRunRetry", fields: [parentRunId], references: [id])
  retries           AutomationRun[]   @relation("AutomationRunRetry")
  createdBy         User?             @relation("AutomationRunCreatedBy", fields: [createdById], references: [id])

  jobs AutomationJob[]
  logs AutomationRunLog[]

  @@index([automationId, status])
  @@index([workspaceId, status])
  @@index([status, scheduledAt])
  @@index([status, resumeAt])
}

model AutomationRunLog {
  id        String   @id @default(cuid())
  runId     String
  nodeId    String?
  level     String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  run AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
}

enum AutomationJobStatus {
  QUEUED
  CLAIMED
  RUNNING
  WAITING
  SUCCEEDED
  FAILED
  CANCELLED
  TIMED_OUT
  /// Épuisement des tentatives, ou politique de retry "manual" : le job est
  /// posé dans la Dead Letter Queue (une requête sur ce statut, pas une
  /// table séparée — voir `src/lib/automation/dlq/`) en attendant une
  /// décision explicite (relance manuelle ou abandon).
  DEAD_LETTERED
}

/// Le cœur du noyau de jobs (voir ADR 0031/0032) : chaque exécution d'un
/// noeud d'`AutomationRun` devient une ligne durable ici — individuellement
/// journalisée, retryable, verrouillable, priorisée, et in fine
/// dead-letterable. Un `AutomationJob` peut aussi exister SANS
/// `automationRunId` (job "ad hoc" enfilé directement par n'importe quel
/// module — agents, Workflow Engine, Knowledge Engine — voulant les
/// garanties du noyau sans jamais construire de graphe). C'est la table
/// que le Queue Manager Postgres (défaut) réclame atomiquement via
/// `FOR UPDATE SKIP LOCKED` (voir `src/lib/automation/queue/`).
model AutomationJob {
  id               String              @id @default(cuid())
  organizationId   String
  workspaceId      String
  automationId     String?
  automationRunId  String?
  nodeId           String?
  jobType          String
  status           AutomationJobStatus @default(QUEUED)
  priority         Int                 @default(0)
  input            Json?
  output           Json?
  error            Json?
  attempt          Int                 @default(0)
  maxAttempts      Int                 @default(1)
  retryPolicy      Json?
  lockKey          String?
  concurrencyKey   String?
  concurrencyLimit Int?
  rateLimitKey     String?
  timeoutMs        Int?
  scheduledAt      DateTime            @default(now())
  claimedAt        DateTime?
  claimedBy        String?
  startedAt        DateTime?
  finishedAt       DateTime?
  resumeAt         DateTime?
  cancelledAt      DateTime?
  durationMs       Int?
  createdById      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation    Automation?    @relation(fields: [automationId], references: [id], onDelete: Cascade)
  automationRun AutomationRun? @relation(fields: [automationRunId], references: [id], onDelete: Cascade)

  logs AutomationJobLog[]

  @@index([status, scheduledAt])
  @@index([status, resumeAt])
  @@index([organizationId, workspaceId, status])
  @@index([concurrencyKey, status])
  @@index([lockKey])
  @@index([automationRunId])
  @@index([automationId])
}

model AutomationJobLog {
  id        String   @id @default(cuid())
  jobId     String
  level     String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  job AutomationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

/// Verrou par bail (lease) sur une clé arbitraire — voir ADR 0032 : un
/// verrou consultatif Postgres (`pg_advisory_lock`) est écarté à cause de
/// son affinité de connexion incompatible avec le pool de Prisma ; une
/// ligne avec contrainte unique + expiration est correcte quel que soit le
/// nombre de processus/connexions.
model AutomationLock {
  id         String   @id @default(cuid())
  lockKey    String   @unique
  holderId   String
  acquiredAt DateTime @default(now())
  expiresAt  DateTime
  metadata   Json?

  @@index([expiresAt])
}

enum AutomationCircuitState {
  CLOSED
  OPEN
  HALF_OPEN
}

/// État du disjoncteur (circuit breaker) par périmètre (`key` — par exemple
/// `automation:<id>` ou `jobType:<clé>`), persisté pour rester cohérent
/// entre plusieurs processus/instances (voir ADR 0033).
model AutomationCircuitBreaker {
  id            String                 @id @default(cuid())
  key           String                 @unique
  automationId  String?
  state         AutomationCircuitState @default(CLOSED)
  failureCount  Int                    @default(0)
  lastFailureAt DateTime?
  openedAt      DateTime?
  resetAt       DateTime?
  updatedAt     DateTime               @updatedAt

  automation Automation? @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
}

// ---------------------------------------------------------------------------
// Observabilité (v0.9 bis, AR-0049) — voir docs/adr, ROADMAP.md §1 novies.
// Métriques de latence API, appliquées de façon INCRÉMENTALE (quelques
// routes représentatives instrumentées via `withApiMetrics`, jamais un
// middleware global) — voir `src/lib/observability/api-metrics.ts`. Le coût
// IA (`AIRequest.estimatedCostUsd`, déjà existant depuis v0.3) et le taux
// d'échec d'envoi email (`EmailEvent`, déjà existant depuis v0.1) sont
// agrégés directement depuis ces tables existantes, sans nouveau modèle.
// ---------------------------------------------------------------------------

/// Une ligne par requête API instrumentée — `organizationId` nul si la
/// requête a échoué avant résolution de l'acteur (ex. non authentifiée).
model ApiRequestMetric {
  id             String   @id @default(cuid())
  organizationId String?
  route          String
  method         String
  statusCode     Int
  durationMs     Int
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([route])
}

// ---------------------------------------------------------------------------
// Métriques de sauvegarde (v1.3, AR-0174) — historique durable des
// exécutions de `scripts/backup-database.ts`/`verify-database-backup.ts`/
// `backup-s3-objects.ts`/`verify-s3-backup.ts`, jusqu'ici seulement
// consignées dans un fichier `.meta.json` local au répertoire de sauvegarde
// (perdu si ce répertoire n'est pas conservé entre exécutions/instances).
// Réglage de DÉPLOIEMENT (une seule base par instance), jamais par
// organisation — voir `scripts/backup-metrics-report.ts` (CLI, pas
// d'endpoint web : la sauvegarde est une préoccupation d'exploitation,
// pas une métrique consultable par un administrateur d'organisation client,
// pour éviter toute fuite d'information inter-tenant).
// ---------------------------------------------------------------------------

enum BackupRunKind {
  DATABASE_DUMP
  DATABASE_RESTORE_VERIFY
  S3_BACKUP
  S3_RESTORE_VERIFY
}

model BackupRun {
  id           String        @id @default(cuid())
  kind         BackupRunKind
  success      Boolean
  startedAt    DateTime
  finishedAt   DateTime
  durationMs   Int
  sizeBytes    Int?
  sha256       String?
  errorMessage String?
  createdAt    DateTime      @default(now())

  @@index([kind, createdAt])
}

// ---------------------------------------------------------------------------
// Onboarding guidé (v1.4, AR-0178) — progression persistée pour permettre à
// un nouveau client de reprendre le parcours d'une session à l'autre (jamais
// un état en mémoire/session uniquement). Une seule ligne par organisation :
// le parcours guidé est une propriété de l'organisation, pas de l'utilisateur
// qui l'a commencé (un coéquipier invité en cours de route doit voir la même
// progression).
// ---------------------------------------------------------------------------

enum OnboardingStepKey {
  PROFILE
  INVITE_TEAM
  CONNECT_TOOL
  CHOOSE_TEMPLATE
  LAUNCH_DEMO
  VIEW_RESULT
}

model OnboardingProgress {
  id                  String              @id @default(cuid())
  organizationId      String              @unique
  currentStep         OnboardingStepKey   @default(PROFILE)
  completedSteps      OnboardingStepKey[] @default([])
  /// Clé du template d'automatisation choisi à l'étape CHOOSE_TEMPLATE (ex. "template-nouveau-prospect").
  selectedTemplateKey String?
  /// Automatisation clonée dans le workspace à partir du template choisi (étape LAUNCH_DEMO).
  demoAutomationId    String?
  /// Exécution de démonstration déclenchée manuellement (étape LAUNCH_DEMO), consultée à l'étape VIEW_RESULT.
  demoRunId           String?
  completedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Compta Vellano — module de comptabilité simplifiée pour pizzeria (ajouté à
// la demande directe du client, hors backlog Autorun/Provence 360 — voir
// docs/adr/0043-compta-vellano-module.md). Vertical métier isolé et
// namespacé (préfixe `Compta*`) : réutilise l'organisation/l'authentification/
// le stockage/les logs existants, mais aucune donnée partagée avec le CRM
// Provence 360 (pas de FK vers `Lead`/`Company`/etc.). Conçu pour rester
// extensible sans migration destructrice : scanner OCR/IA et assistant IA
// arriveront comme des couches supplémentaires au-dessus de ce même modèle
// (voir `src/lib/compta/`), jamais en renommant/supprimant des champs
// existants ici.
// ---------------------------------------------------------------------------

enum ComptaPaymentMethod {
  CASH
  CARD
  TRANSFER
  /// Ticket restaurant (v2, module Caisse).
  MEAL_VOUCHER
  /// Chèque (v2, module Caisse).
  CHEQUE
  OTHER
}

/// Statut d'une vente (v2) — `COMPLETED` reste le comportement historique
/// (comportement inchangé pour toute vente créée avant v2, par défaut).
/// `CANCELLED` : vente annulée (saisie erronée), exclue de tous les agrégats
/// (CA, TVA, marge) — jamais supprimée physiquement pour garder l'historique
/// d'audit. `REFUNDED` : n'est JAMAIS posé sur la vente d'origine (qui reste
/// `COMPLETED`, le CA réel du jour où elle a eu lieu ne doit pas bouger) —
/// c'est le statut d'une vente de remboursement séparée, montants négatifs,
/// liée via `refundOfSaleId`. Voir `src/lib/compta/sale-service.ts`.
enum ComptaSaleStatus {
  COMPLETED
  CANCELLED
  REFUNDED
}

enum ComptaExpenseCategory {
  INGREDIENTS
  RENT
  UTILITIES
  SALARIES
  EQUIPMENT
  MARKETING
  TAXES
  OTHER
}

/// Catalogue produits (pizzas, boissons, desserts...) — source pour la saisie
/// de vente et, plus tard, pour le rapprochement automatique des lignes
/// reconnues par le scanner OCR/IA (`aliases`, déjà prévu ici pour éviter une
/// migration future).
model ComptaProduct {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  category       String
  /// Prix de vente TTC, en centimes.
  price          Int
  /// Taux de TVA appliqué, en pourcentage (10 = restauration sur place, 5.5 = à emporter...).
  vatRate        Float    @default(10)
  /// Coût matière estimé, en centimes — sert au calcul de marge (`price - costPrice`). Nullable : pas toujours connu à la création.
  costPrice      Int?
  /// Autres libellés reconnus pour ce produit (ticket manuscrit, abréviations...) — alimenté manuellement pour l'instant, par les corrections du scanner une fois livré.
  aliases        String[] @default([])
  isActive       Boolean  @default(true)
  /// Favori (v2, mode rapide) — affiché en priorité dans les tuiles de vente rapide. `false` par défaut : comportement inchangé pour tout produit existant.
  isFavorite     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  saleLines    ComptaSaleLine[]
  recipeLines  ComptaRecipeLine[]

  @@index([organizationId])
  @@index([organizationId, isFavorite])
}

/// Vente enregistrée manuellement (v1) ou, plus tard, validée depuis le
/// scanner OCR/IA — toujours après validation explicite, jamais un
/// enregistrement automatique (même principe que `Quote`/`Invoice` dans le
/// CRM). `subtotalAmount`/`vatAmount`/`totalAmount` sont dérivés des lignes
/// au moment de la création, jamais recalculés à la volée en lecture.
model ComptaSale {
  id              String              @id @default(cuid())
  organizationId  String
  workspaceId     String?
  soldAt          DateTime
  paymentMethod   ComptaPaymentMethod
  /// Remise globale de la vente, en pourcentage (0-100).
  discountPercent Float               @default(0)
  /// Somme des lignes avant remise/TVA, en centimes.
  subtotalAmount  Int                 @default(0)
  vatAmount       Int                 @default(0)
  /// Total TTC après remise, en centimes.
  totalAmount     Int                 @default(0)
  notes           String?
  createdById     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  /// Numéro de vente auto-incrémenté par organisation, ex. "V-2026-0001" (v2) — `null` pour les
  /// ventes créées avant v2 (jamais backfillé rétroactivement), voir `sale-service.ts#nextSaleReference`.
  reference       String?
  /// `COMPLETED` par défaut : comportement inchangé pour toute vente existante avant v2.
  status          ComptaSaleStatus    @default(COMPLETED)
  customerId      String?
  /// Renseigné uniquement sur une vente de remboursement (`status = REFUNDED`), jamais sur la vente d'origine.
  refundOfSaleId  String?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?       @relation(fields: [workspaceId], references: [id])
  createdBy    User?            @relation(fields: [createdById], references: [id])
  customer     ComptaCustomer?  @relation(fields: [customerId], references: [id])
  refundOfSale ComptaSale?      @relation("ComptaSaleRefund", fields: [refundOfSaleId], references: [id])
  refunds      ComptaSale[]     @relation("ComptaSaleRefund")
  lines        ComptaSaleLine[]

  @@unique([organizationId, reference])
  @@index([organizationId, soldAt])
  @@index([workspaceId])
  @@index([customerId])
  @@index([refundOfSaleId])
}

model ComptaSaleLine {
  id          String  @id @default(cuid())
  saleId      String
  productId   String?
  /// Nom du produit au moment de la vente (copie figée) — la ligne reste lisible même si le produit est renommé/désactivé ensuite.
  productName String
  quantity    Int     @default(1)
  /// Prix unitaire TTC au moment de la vente, en centimes.
  unitPrice   Int
  vatRate     Float
  /// Total de la ligne TTC (quantité × prix unitaire), en centimes.
  lineTotal   Int

  sale    ComptaSale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product ComptaProduct? @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

/// Fournisseurs (v1 : coordonnées + solde restant dû, saisi manuellement).
/// Historique factures/paiements détaillé prévu comme extension future
/// (liens `ComptaExpense.supplierId` déjà en place pour ça).
model ComptaSupplier {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String?
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  notes          String?
  /// Solde restant dû à ce fournisseur, en centimes — mis à jour manuellement en v1 (pas de rapprochement automatique des paiements).
  balanceDue     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      Workspace?            @relation(fields: [workspaceId], references: [id])
  expenses       ComptaExpense[]
  purchaseOrders ComptaPurchaseOrder[]

  @@index([organizationId])
  @@index([workspaceId])
}

/// Dépense (v1 : saisie manuelle ; la photo de facture, une fois prise en
/// charge, sera stockée via le modèle `Attachment` générique existant avec
/// `entityType = "ComptaExpense"` — pas de nouveau modèle de stockage à
/// prévoir ici).
model ComptaExpense {
  id             String                @id @default(cuid())
  organizationId String
  workspaceId    String?
  spentAt        DateTime
  /// Montant TTC, en centimes.
  amount         Int
  vatRate        Float                 @default(20)
  /// TVA récupérable, en centimes (dérivée de `amount`/`vatRate` au moment de la saisie).
  vatAmount      Int                   @default(0)
  category       ComptaExpenseCategory @default(OTHER)
  description    String
  supplierId     String?
  createdById    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?      @relation(fields: [workspaceId], references: [id])
  supplier     ComptaSupplier? @relation(fields: [supplierId], references: [id])
  createdBy    User?           @relation(fields: [createdById], references: [id])

  @@index([organizationId, spentAt])
  @@index([workspaceId])
  @@index([supplierId])
}

/// Comptage de caisse (billets/pièces) — `denominations` garde le détail
/// billet-par-billet/pièce-par-pièce pour l'écran de comptage, `differenceAmount`
/// est dérivé une seule fois à la création (`countedAmount - theoreticalAmount`),
/// jamais recalculé à la volée.
model ComptaCashCount {
  id                String   @id @default(cuid())
  organizationId    String
  workspaceId       String?
  countedAt         DateTime @default(now())
  theoreticalAmount Int
  countedAmount     Int
  differenceAmount  Int
  /// Détail du comptage billets/pièces, ex. `{"bills": {"50": 2, "20": 5}, "coins": {"2": 10}}` — libre, pas de schéma imposé côté base.
  denominations     Json?
  notes             String?
  createdById       String?
  createdAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id])
  createdBy    User?        @relation(fields: [createdById], references: [id])

  @@index([organizationId, countedAt])
  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Compta Vellano v2 — Production Ready (stock/recettes, achats, caisse
// ouverture/fermeture, clients/fidélité). Additif uniquement : aucun champ
// v1 renommé ou supprimé, voir chaque modèle ci-dessus pour le détail des
// extensions. Nouveaux modèles namespacés `Compta*`, mêmes conventions
// (organizationId, cuid, centimes pour l'argent).
// ---------------------------------------------------------------------------

enum ComptaStockMovementType {
  /// Décrément automatique lors d'une vente (recette du produit vendu).
  SALE_DEDUCTION
  /// Incrément lors de la réception d'une commande fournisseur.
  PURCHASE_RECEPTION
  /// Ajustement manuel (inventaire, casse, péremption...).
  CORRECTION
  /// Stock initial saisi à la création de l'ingrédient.
  INITIAL
}

/// Ingrédient (farine, mozzarella...) — unité libre (`kg`, `L`, `unité`...),
/// pas de référentiel d'unités imposé pour rester simple pour une pizzeria.
model ComptaIngredient {
  id                String   @id @default(cuid())
  organizationId    String
  name              String
  unit              String
  stockQuantity     Float    @default(0)
  /// Seuil d'alerte stock faible, dans la même unité que `unit` — `null` = pas d'alerte configurée.
  lowStockThreshold Float?
  /// Coût unitaire estimé, en centimes — sert au calcul de marge produit via la recette.
  unitCost          Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipeLines   ComptaRecipeLine[]
  movements     ComptaStockMovement[]
  purchaseLines ComptaPurchaseOrderLine[]

  @@index([organizationId])
  @@index([organizationId, name])
}

/// Ligne de recette : quantité d'un ingrédient nécessaire pour UNE unité vendue du produit.
/// Ex. Pizza Reine -> 1 pâte + 0.1L sauce tomate + 0.08kg jambon + ... Décrémenté automatiquement
/// à chaque vente (voir `stock-service.ts#deductStockForSaleLine`), jamais recalculé à la volée.
model ComptaRecipeLine {
  id             String @id @default(cuid())
  organizationId String
  productId      String
  ingredientId   String
  /// Quantité d'ingrédient consommée par unité de produit vendue, même unité que `ComptaIngredient.unit`.
  quantity       Float

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      ComptaProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   ComptaIngredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId])
  @@index([organizationId])
  @@index([productId])
}

/// Historique des mouvements de stock — jamais un simple `UPDATE` silencieux de `stockQuantity`,
/// toujours une ligne créée (même convention d'audit que `AuditLog`, mais dédiée au stock pour
/// permettre un filtrage/export propre par ingrédient).
model ComptaStockMovement {
  id                     String                  @id @default(cuid())
  organizationId         String
  ingredientId           String
  type                   ComptaStockMovementType
  /// Variation de stock : positive = entrée, négative = sortie, dans l'unité de l'ingrédient.
  quantityDelta          Float
  /// Stock résultant après application de ce mouvement (snapshot, pratique pour l'historique sans recalcul).
  resultingQuantity      Float
  reason                 String?
  relatedSaleId          String?
  relatedPurchaseOrderId String?
  createdById            String?
  createdAt              DateTime                @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ingredient   ComptaIngredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  createdBy    User?            @relation(fields: [createdById], references: [id])

  @@index([organizationId, createdAt])
  @@index([ingredientId, createdAt])
}

enum ComptaPurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

/// Commande fournisseur — la réception (`RECEIVED`) est l'action qui incrémente le stock des
/// ingrédients commandés (voir `purchase-service.ts#receivePurchaseOrder`), jamais la création
/// de la commande elle-même (le stock physique n'a pas encore bougé tant que ce n'est pas livré).
model ComptaPurchaseOrder {
  id             String                    @id @default(cuid())
  organizationId String
  supplierId     String
  status         ComptaPurchaseOrderStatus @default(DRAFT)
  orderedAt      DateTime?
  receivedAt     DateTime?
  /// Somme des lignes, en centimes — dérivée à la création/mise à jour des lignes, jamais recalculée à la volée en lecture.
  totalAmount    Int                       @default(0)
  notes          String?
  createdById    String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     ComptaSupplier            @relation(fields: [supplierId], references: [id])
  createdBy    User?                     @relation(fields: [createdById], references: [id])
  lines        ComptaPurchaseOrderLine[]
  payments     ComptaPurchasePayment[]

  @@index([organizationId, createdAt])
  @@index([supplierId])
}

model ComptaPurchaseOrderLine {
  id              String  @id @default(cuid())
  purchaseOrderId String
  ingredientId    String?
  /// Libellé au moment de la commande (copie figée), même principe que `ComptaSaleLine.productName`.
  label           String
  quantity        Float
  /// Coût unitaire TTC au moment de la commande, en centimes.
  unitCost        Int
  lineTotal       Int

  purchaseOrder ComptaPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredient    ComptaIngredient?   @relation(fields: [ingredientId], references: [id])

  @@index([purchaseOrderId])
  @@index([ingredientId])
}

/// Paiement d'une commande fournisseur, partiel ou complet — même principe que `InvoicePayment`
/// côté CRM : plusieurs paiements possibles, jamais un seul champ `paid: Boolean`.
model ComptaPurchasePayment {
  id              String   @id @default(cuid())
  organizationId  String
  purchaseOrderId String
  amount          Int
  paidAt          DateTime @default(now())
  method          String
  createdById     String?
  createdAt       DateTime @default(now())

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder ComptaPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  createdBy     User?               @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([purchaseOrderId])
}

/// Session de caisse (ouverture/fermeture) — la répartition par mode de paiement (espèces, CB,
/// tickets restaurant, chèques) n'est PAS stockée ici : elle est calculée à la volée depuis
/// `ComptaSale` sur la fenêtre `[openedAt, closedAt ?? maintenant]` (voir
/// `cash-session-service.ts#getPaymentBreakdown`) pour ne jamais désynchroniser un total figé
/// des ventes réelles. Une session `null` sur `closedAt` est la session actuellement ouverte —
/// au plus une par organisation à la fois (vérifié par le service, pas par une contrainte SQL,
/// même principe que `Invoice`/`Quote` où les invariants de cycle de vie vivent dans le service).
model ComptaCashSession {
  id                   String    @id @default(cuid())
  organizationId       String
  workspaceId          String?
  openedAt             DateTime  @default(now())
  openedById           String?
  /// Fond de caisse au moment de l'ouverture, en centimes.
  openingFloat         Int
  closedAt             DateTime?
  closedById           String?
  /// Montant compté à la fermeture (espèces uniquement), en centimes.
  closingCountedAmount Int?
  /// Montant théorique en espèces à la fermeture (fond de caisse + ventes espèces de la session), en centimes.
  theoreticalAmount    Int?
  differenceAmount     Int?
  denominations        Json?
  notes                String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id])
  openedBy     User?        @relation("ComptaCashSessionOpenedBy", fields: [openedById], references: [id])
  closedBy     User?        @relation("ComptaCashSessionClosedBy", fields: [closedById], references: [id])

  @@index([organizationId, openedAt])
  @@index([workspaceId])
}

/// Client (v2, "Données") — coordonnées + solde de points de fidélité simple (1 point par euro
/// TTC dépensé, crédité à la création d'une vente qui le référence, jamais recalculé
/// rétroactivement par un job). Pas de mécanisme de dépense de points en v2 (ajustement manuel
/// possible via `updateCustomer`) — un vrai catalogue de récompenses est une extension future.
model ComptaCustomer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  notes          String?
  loyaltyPoints  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales        ComptaSale[]

  @@index([organizationId])
  @@index([organizationId, name])
}
