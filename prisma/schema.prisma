// Provence 360 — schéma de données
// Voir docs/02-ARCHITECTURE.md pour la description des entités et relations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Organisation, utilisateurs, rôles
// ---------------------------------------------------------------------------

enum MembershipRole {
  OWNER_ADMIN
  SALES
  PROVIDER
}

// Rôle au niveau *workspace* (voir ADR 0005/0006) — distinct et additif par
// rapport à `MembershipRole` (rôle d'organisation, inchangé). N'est consommé
// que par `WorkspaceMembership` et `src/lib/workspace-permissions.ts`.
enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  COMMERCIAL
  OPERATOR
  ACCOUNTANT
  SUPPORT
  VIEWER
}

model Organization {
  id                       String   @id @default(cuid())
  name                     String
  description              String?
  website                  String?
  logoUrl                  String?
  services                 String[] @default([])
  zones                    String[] @default([])
  pricingNote              String?
  pitch                    String?
  testimonials             Json[]   @default([])
  portfolioLinks           String[] @default([])
  availabilityNote         String?
  tone                     String   @default("professionnel")
  emailSignature           String?
  dailySendLimit           Int      @default(50)
  rampUpEnabled            Boolean  @default(true)
  scoringRules             Json?
  requireMessageValidation Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  memberships          Membership[]
  workspaces           Workspace[]
  agentDefinitions     AgentDefinition[]
  agentInstallations   AgentInstallation[]
  commercialProspects  CommercialProspect[]
  commercialActions    CommercialAction[]
  territories          Territory[]
  icps               IdealCustomerProfile[]
  leads              Lead[]
  tags               Tag[]
  campaigns          Campaign[]
  sequences          Sequence[]
  emailAccounts      EmailAccount[]
  tasks              Task[]
  appointments       Appointment[]
  opportunities      Opportunity[]
  quotes             Quote[]
  customers          Customer[]
  missions           Mission[]
  services_          Service[]
  providers          Provider[]
  automationRules    AutomationRule[]
  notifications      Notification[]
  suppressionEntries SuppressionEntry[]
  consentRecords     ConsentRecord[]
  auditLogs          AuditLog[]
  aiRequests         AIRequest[]
  integrations       Integration[]
  webhookEvents      WebhookEvent[]
  loginEvents        LoginEvent[]

  @@index([name])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships                 Membership[]
  workspaceMemberships        WorkspaceMembership[]
  workspaceInvitationsSent    WorkspaceInvitation[]      @relation("WorkspaceInvitationInvitedBy")
  agentInstallationsInstalled AgentInstallation[]        @relation("AgentInstalledBy")
  agentRunsCreated            AgentRun[]                 @relation("AgentRunCreatedBy")
  agentInterventionsAssigned  AgentInterventionRequest[] @relation("AgentInterventionAssignedTo")
  agentInterventionsResolved  AgentInterventionRequest[] @relation("AgentInterventionResolvedBy")
  commercialActionsDecided    CommercialAction[]         @relation("CommercialActionDecidedBy")
  promptTemplatesCreated      PromptTemplate[]           @relation("PromptTemplateCreatedBy")
  sessions                    Session[]
  passwordResets              PasswordResetToken[]
  loginEvents                 LoginEvent[]
  auditLogs                   AuditLog[]
  aiRequests                  AIRequest[]
  tasksAssigned               Task[]                     @relation("TaskAssignee")
  appointments                Appointment[]              @relation("AppointmentOwner")
  notifications               Notification[]
  messagesValidated           Message[]                  @relation("MessageValidatedBy")
  notesAuthored               LeadNote[]
}

// ---------------------------------------------------------------------------
// Workspaces (sous-espaces au sein d'une organisation — voir ADR 0005)
// ---------------------------------------------------------------------------

model Workspace {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  isDefault      Boolean   @default(false)
  settings       Json?
  archivedAt     DateTime?
  archivedById   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  WorkspaceMembership[]
  invitations  WorkspaceInvitation[]
  sessions     Session[]
  leads        Lead[]

  agentInstallations        AgentInstallation[]
  agentMemoryEntries        AgentMemoryEntry[]
  agentMessages             AgentMessage[]
  agentInterventionRequests AgentInterventionRequest[]
  agentPlans                AgentPlan[]
  commercialProspects       CommercialProspect[]
  commercialActions         CommercialAction[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model WorkspaceMembership {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  invitedById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model WorkspaceInvitation {
  id          String                    @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole
  token       String                    @unique
  status      WorkspaceInvitationStatus @default(PENDING)
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime                  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("WorkspaceInvitationInvitedBy", fields: [invitedById], references: [id])

  @@index([workspaceId])
  @@index([email])
}

model Membership {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole
  territoryId    String?
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  territory    Territory?   @relation(fields: [territoryId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model Session {
  id                String   @id @default(cuid())
  userId            String
  token             String   @unique
  userAgent         String?
  ipAddress         String?
  // Workspace actif de cette session — jamais fourni tel quel par le client :
  // toute mise à jour passe par une route serveur qui revérifie
  // `WorkspaceMembership` avant d'écrire ce champ (voir ADR 0005,
  // src/lib/workspace-context.ts).
  activeWorkspaceId String?
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeWorkspace Workspace? @relation(fields: [activeWorkspaceId], references: [id])

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginEvent {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  email          String
  success        Boolean
  reason         String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Territoires & prestataires
// ---------------------------------------------------------------------------

model Territory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  centerCity     String
  radiusKm       Int      @default(40)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]
  providers    Provider[]
  leads        Lead[]
  missions     Mission[]

  @@unique([organizationId, name])
}

model Provider {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  territoryId    String?
  name           String
  email          String
  phone          String?
  specialties    String[] @default([])
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  territory    Territory?   @relation(fields: [territoryId], references: [id])
  missions     Mission[]

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Ciblage : ICP
// ---------------------------------------------------------------------------

enum LeadCategory {
  AIRBNB_HOST
  VILLA
  HOTEL
  CAMPING
  REAL_ESTATE_AGENCY
  RESTAURANT
  EVENT_VENUE
  RETAIL
  OTHER
}

model IdealCustomerProfile {
  id                     String       @id @default(cuid())
  organizationId         String
  name                   String
  category               LeadCategory
  zones                  String[]     @default([])
  sizeNote               String?
  priceRange             String?
  estimatedUnits         String?
  hasVirtualTourExpected Boolean      @default(false)
  websiteQualityNote     String?
  socialPresenceNote     String?
  minRating              Float?
  minReviewCount         Int?
  priority               Int          @default(3)
  positiveKeywords       String[]     @default([])
  exclusionCriteria      String[]     @default([])
  isActive               Boolean      @default(true)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Prospects (Lead)
// ---------------------------------------------------------------------------

enum LeadStage {
  NEW
  TO_ANALYZE
  QUALIFIED
  MESSAGE_TO_VALIDATE
  CONTACTED
  FOLLOW_UP_SCHEDULED
  REPLIED
  INTERESTED
  APPOINTMENT_SCHEDULED
  QUOTE_SENT
  NEGOTIATION
  WON
  LOST
  TO_RECONTACT_LATER
  UNSUBSCRIBED
}

enum LeadSourceType {
  MANUAL
  CSV_IMPORT
  API
  REFERRAL
  OTHER
}

model LeadSource {
  id             String         @id @default(cuid())
  organizationId String
  type           LeadSourceType
  label          String
  fileName       String?
  importedById   String?
  createdAt      DateTime       @default(now())

  leads Lead[]

  @@index([organizationId])
}

model Lead {
  id             String  @id @default(cuid())
  organizationId String
  // Sous-espace de travail au sein de l'organisation (voir ADR 0005).
  // Nullable et non exploité pour le filtrage aujourd'hui par les routes
  // existantes (qui continuent de scoper par organizationId uniquement) ;
  // sert de première preuve de concept du scoping par workspace et aux
  // tests d'isolation inter-workspace.
  workspaceId    String?
  icpId          String?
  territoryId    String?
  sourceId       String?
  campaignId     String?
  assignedToId   String?

  establishmentName String
  category          LeadCategory @default(OTHER)
  stage             LeadStage    @default(NEW)

  websiteUrl       String?
  publicListingUrl String?
  address          String?
  city             String?
  region           String?
  country          String  @default("France")
  latitude         Float?
  longitude        Float?

  reviewCount   Int?
  averageRating Float?
  socialLinks   Json?

  hasVirtualTour Boolean?
  closedBusiness Boolean  @default(false)

  tagsRelation Tag[]   @relation("LeadTags")
  notesLegacy  String?

  isSuppressed Boolean   @default(false)
  suppressedAt DateTime?

  importedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?            @relation(fields: [workspaceId], references: [id])
  icp          IdealCustomerProfile? @relation(fields: [icpId], references: [id])
  territory    Territory?            @relation(fields: [territoryId], references: [id])
  source       LeadSource?           @relation(fields: [sourceId], references: [id])
  campaign     Campaign?             @relation(fields: [campaignId], references: [id])

  contacts      LeadContact[]
  analyses      LeadAnalysis[]
  scores        LeadScore[]
  notes         LeadNote[]
  enrollments   Enrollment[]
  messages      Message[]
  conversations Conversation[]
  tasks         Task[]
  appointments  Appointment[]
  opportunities Opportunity[]
  quotes        Quote[]
  customer      Customer?
  aiRequests    AIRequest[]
  auditLogs     AuditLog[]

  @@unique([organizationId, publicListingUrl])
  @@index([organizationId, stage])
  @@index([organizationId, city])
  @@index([campaignId])
  @@index([workspaceId])
}

model LeadContact {
  id        String   @id @default(cuid())
  leadId    String
  fullName  String?
  jobTitle  String?
  email     String?
  phone     String?
  isPrimary Boolean  @default(true)
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([email])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([leadId])
}

model Tag {
  id             String @id @default(cuid())
  organizationId String
  name           String
  color          String @default("#6b7280")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]       @relation("LeadTags")

  @@unique([organizationId, name])
}

// ---------------------------------------------------------------------------
// Analyse IA & scoring
// ---------------------------------------------------------------------------

model LeadAnalysis {
  id                       String   @id @default(cuid())
  leadId                   String
  summary                  String
  clienteleType            String?
  digitalPresenceQuality   String?
  hasVirtualTourAssessment String?
  opportunities            String[] @default([])
  recommendedAngle         String?
  recommendedService       String?
  priorityLevel            String
  personalizedArguments    String[] @default([])
  negativeSignals          String[] @default([])
  verifiedFacts            String[] @default([])
  estimatedFacts           String[] @default([])
  missingInfo              String[] @default([])
  aiRequestId              String?
  createdAt                DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model LeadScore {
  id         String   @id @default(cuid())
  leadId     String
  value      Int
  category   String
  breakdown  Json
  computedAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

// ---------------------------------------------------------------------------
// Campagnes, séquences, enrôlement
// ---------------------------------------------------------------------------

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

model Campaign {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  description    String?
  status         CampaignStatus @default(DRAFT)
  sequenceId     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sequence     Sequence?    @relation(fields: [sequenceId], references: [id])
  leads        Lead[]
  enrollments  Enrollment[]

  @@index([organizationId])
}

enum SequenceChannel {
  EMAIL
  LINKEDIN
  SMS
  CALL
}

model Sequence {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps        SequenceStep[]
  campaigns    Campaign[]
  enrollments  Enrollment[]

  @@index([organizationId])
}

model SequenceStep {
  id                 String          @id @default(cuid())
  sequenceId         String
  order              Int
  delayDays          Int
  channel            SequenceChannel
  templateKey        String
  conditions         Json?
  allowedStartHour   Int             @default(8)
  allowedEndHour     Int             @default(18)
  allowedWeekdays    Int[]           @default([1, 2, 3, 4, 5])
  requiresValidation Boolean         @default(true)

  sequence Sequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([sequenceId, order])
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  STOPPED
  COMPLETED
}

enum EnrollmentStopReason {
  REPLIED
  APPOINTMENT_BOOKED
  BECAME_CUSTOMER
  INVALID_ADDRESS
  UNSUBSCRIBED
  SUPPRESSED
  MANUAL
}

model Enrollment {
  id               String                @id @default(cuid())
  leadId           String
  sequenceId       String
  campaignId       String?
  status           EnrollmentStatus      @default(ACTIVE)
  currentStepOrder Int                   @default(0)
  nextRunAt        DateTime?
  stopReason       EnrollmentStopReason?
  startedAt        DateTime              @default(now())
  stoppedAt        DateTime?

  lead     Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sequence Sequence  @relation(fields: [sequenceId], references: [id])
  campaign Campaign? @relation(fields: [campaignId], references: [id])
  messages Message[]

  @@index([leadId])
  @@index([status, nextRunAt])
}

// ---------------------------------------------------------------------------
// Emails / messages
// ---------------------------------------------------------------------------

enum EmailProviderKind {
  DEMO
  SMTP
  GMAIL_API
  OUTLOOK_API
}

model EmailAccount {
  id             String            @id @default(cuid())
  organizationId String
  providerKind   EmailProviderKind @default(DEMO)
  fromName       String
  fromEmail      String
  dailyLimit     Int               @default(50)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([organizationId])
}

enum MessageType {
  FIRST_CONTACT_EMAIL
  FOLLOW_UP_SHORT
  FOLLOW_UP_CASE_STUDY
  LINKEDIN
  CALL_SCRIPT
  SMS
  PROPOSAL
  APPOINTMENT_BRIEF
}

enum MessageTone {
  PROFESSIONAL
  DIRECT_MODERN
  PREMIUM
}

enum MessageLanguage {
  FR
  EN
  HR
  IT
  ES
}

enum MessageStatus {
  DRAFT
  PENDING_VALIDATION
  APPROVED
  REJECTED
  SENT
  FAILED
}

model Message {
  id                String          @id @default(cuid())
  leadId            String
  enrollmentId      String?
  sequenceStepId    String?
  emailAccountId    String?
  type              MessageType
  channel           SequenceChannel @default(EMAIL)
  tone              MessageTone     @default(PROFESSIONAL)
  language          MessageLanguage @default(FR)
  subject           String?
  body              String
  status            MessageStatus   @default(DRAFT)
  aiRequestId       String?
  validatedById     String?
  validatedAt       DateTime?
  sentAt            DateTime?
  providerMessageId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  lead         Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  enrollment   Enrollment?   @relation(fields: [enrollmentId], references: [id])
  sequenceStep SequenceStep? @relation(fields: [sequenceStepId], references: [id])
  emailAccount EmailAccount? @relation(fields: [emailAccountId], references: [id])
  validatedBy  User?         @relation("MessageValidatedBy", fields: [validatedById], references: [id])
  events       EmailEvent[]

  @@index([leadId])
  @@index([status])
}

enum EmailEventType {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  OPENED
  REPLIED
  UNSUBSCRIBED
  FAILED
}

model EmailEvent {
  id        String         @id @default(cuid())
  messageId String
  type      EmailEventType
  metadata  Json?
  createdAt DateTime       @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

enum ReplyIntent {
  INTERESTED
  INFO_REQUEST
  PRICE_REQUEST
  CALLBACK_REQUEST
  NOT_INTERESTED
  ALREADY_EQUIPPED
  WRONG_CONTACT
  UNSUBSCRIBE
  AUTO_REPLY
  INVALID_ADDRESS
  UNKNOWN
}

model Conversation {
  id          String          @id @default(cuid())
  leadId      String
  channel     SequenceChannel @default(EMAIL)
  direction   String
  fromAddress String?
  toAddress   String?
  subject     String?
  body        String
  intent      ReplyIntent?
  aiRequestId String?
  createdAt   DateTime        @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

// ---------------------------------------------------------------------------
// Tâches, rendez-vous
// ---------------------------------------------------------------------------

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

model Task {
  id             String     @id @default(cuid())
  organizationId String
  leadId         String?
  assigneeId     String?
  title          String
  description    String?
  dueAt          DateTime?
  status         TaskStatus @default(OPEN)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id])
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([organizationId, status])
  @@index([assigneeId])
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id             String            @id @default(cuid())
  organizationId String
  leadId         String
  ownerId        String?
  title          String
  startAt        DateTime
  endAt          DateTime
  location       String?
  status         AppointmentStatus @default(SCHEDULED)
  notes          String?
  summary        String?
  nextAction     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  owner        User?        @relation("AppointmentOwner", fields: [ownerId], references: [id])

  @@index([organizationId])
  @@index([leadId])
}

// ---------------------------------------------------------------------------
// Opportunités, devis, offres, clients, missions
// ---------------------------------------------------------------------------

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

model Opportunity {
  id              String            @id @default(cuid())
  organizationId  String
  leadId          String
  name            String
  estimatedValue  Int
  probability     Int               @default(20)
  status          OpportunityStatus @default(OPEN)
  lostReason      String?
  expectedCloseAt DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  quotes       Quote[]

  @@index([organizationId, status])
  @@index([leadId])
}

enum ServiceKind {
  VIRTUAL_TOUR_SIMPLE
  VIRTUAL_TOUR_PREMIUM
  PHOTO_PACK_AND_TOUR
  MULTI_UNIT_OFFER
  UPDATE_SUBSCRIPTION
  OUT_OF_ZONE_TRAVEL
  CUSTOM
}

model Service {
  id             String      @id @default(cuid())
  organizationId String
  kind           ServiceKind
  name           String
  description    String?
  basePrice      Int
  isActive       Boolean     @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quoteLines   QuoteLine[]

  @@index([organizationId])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

model Quote {
  id             String      @id @default(cuid())
  organizationId String
  leadId         String
  opportunityId  String?
  reference      String
  status         QuoteStatus @default(DRAFT)
  totalAmount    Int         @default(0)
  sentAt         DateTime?
  expiresAt      DateTime?
  acceptedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id])
  lines        QuoteLine[]

  @@unique([organizationId, reference])
  @@index([leadId])
}

model QuoteLine {
  id        String  @id @default(cuid())
  quoteId   String
  serviceId String?
  label     String
  quantity  Int     @default(1)
  unitPrice Int

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id])

  @@index([quoteId])
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String   @unique
  wonAt          DateTime @default(now())
  lifetimeValue  Int      @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  missions     Mission[]

  @@index([organizationId])
}

enum MissionStatus {
  PROPOSED
  ACCEPTED
  DECLINED
  IN_PROGRESS
  DELIVERED
  CANCELLED
}

model Mission {
  id             String        @id @default(cuid())
  organizationId String
  customerId     String
  providerId     String?
  territoryId    String?
  title          String
  status         MissionStatus @default(PROPOSED)
  scheduledAt    DateTime?
  deliverables   Json[]        @default([])
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider     Provider?    @relation(fields: [providerId], references: [id])
  territory    Territory?   @relation(fields: [territoryId], references: [id])

  @@index([organizationId, status])
}

// ---------------------------------------------------------------------------
// Automatisation, notifications, conformité, audit
// ---------------------------------------------------------------------------

model AutomationRule {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  triggerType    String
  triggerConfig  Json
  actionType     String
  actionConfig   Json
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String?
  type           String
  title          String
  body           String?
  link           String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, userId])
}

enum SuppressionReason {
  UNSUBSCRIBED
  BOUNCED
  MANUAL_EXCLUSION
  COMPLAINT
}

model SuppressionEntry {
  id             String            @id @default(cuid())
  organizationId String
  email          String?
  phone          String?
  reason         SuppressionReason
  note           String?
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([organizationId, phone])
}

enum ConsentBasis {
  LEGITIMATE_INTEREST_B2B
  EXPLICIT_CONSENT
  CONTRACT
}

model ConsentRecord {
  id             String       @id @default(cuid())
  organizationId String
  leadId         String?
  email          String?
  basis          ConsentBasis
  note           String?
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  leadId         String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  lead         Lead?         @relation(fields: [leadId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}

enum AIRequestKind {
  ANALYZE_LEAD
  SCORE_RECOMMENDATION
  GENERATE_MESSAGE
  CLASSIFY_REPLY
  SUMMARIZE_CONVERSATION
  RECOMMEND_NEXT_ACTION
  TRANSLATE
  GENERATE_REPORT
}

enum AIRequestStatus {
  COMPLETED
  FAILED
  PENDING_VALIDATION
  VALIDATED
  REJECTED
}

model AIRequest {
  id               String          @id @default(cuid())
  organizationId   String
  userId           String?
  leadId           String?
  // Rattache un appel IA déclenché par un agent à son exécution — permet
  // d'agréger le coût IA par run/installation (voir docs/adr/0007 et
  // ROADMAP.md MOD-22). Nul pour tous les appels IA hors Agent Framework
  // (le reste de l'application, inchangé).
  agentRunId       String?
  kind             AIRequestKind
  provider         String
  model            String
  prompt           String
  response         String
  estimatedCostUsd Float           @default(0)
  status           AIRequestStatus @default(COMPLETED)
  createdAt        DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])
  lead         Lead?        @relation(fields: [leadId], references: [id])
  agentRun     AgentRun?    @relation(fields: [agentRunId], references: [id])

  @@index([organizationId, kind])
  @@index([leadId])
  @@index([agentRunId])
}

enum IntegrationKind {
  EMAIL
  AI
  CALENDAR
  DATA_PROVIDER
}

enum IntegrationStatus {
  DEMO
  CONNECTED
  DISCONNECTED
  ERROR
}

model Integration {
  id             String            @id @default(cuid())
  organizationId String
  kind           IntegrationKind
  name           String
  status         IntegrationStatus @default(DEMO)
  config         Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, kind, name])
}

model WebhookEvent {
  id             String    @id @default(cuid())
  organizationId String?
  source         String
  eventType      String
  payload        Json
  signatureValid Boolean   @default(false)
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, eventType])
}

// ---------------------------------------------------------------------------
// Agent Framework (v0.3) — infrastructure uniquement, aucun agent métier.
// Voir docs/adr/0007, 0008, 0009 et docs/02-ARCHITECTURE.md §10.
// Étendu en v0.4 par l'Agent Director (orchestration, voir plus bas dans ce
// même fichier) — toujours aucun agent métier réel.
// ---------------------------------------------------------------------------

enum AgentDefinitionStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
  ARCHIVED
}

/// Catalogue des agents disponibles (le "quoi"). organizationId nul = agent
/// global fourni par Autorun ; non nul = agent propre à une organisation
/// (préparé pour des agents personnalisés futurs). Aucune logique
/// exécutable ici : `runtimeKey` référence l'implémentation TypeScript
/// (src/lib/agents/registry.ts).
model AgentDefinition {
  id                  String                @id @default(cuid())
  organizationId      String?
  key                 String
  name                String
  description         String?
  version             String                @default("0.1.0")
  status              AgentDefinitionStatus @default(DRAFT)
  author              String
  category            String
  icon                String?
  runtimeKey          String
  configSchema        Json?
  declaredToolKeys    String[]              @default([])
  declaredPermissions String[]              @default([])
  compatibleAiModels  String[]              @default([])
  defaultLimits       Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  organization  Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  installations AgentInstallation[]

  @@unique([organizationId, key])
  @@index([status])
  @@index([category])
}

enum AgentInstallationStatus {
  INSTALLED
  ACTIVE
  INACTIVE
  SUSPENDED
  UNINSTALLED
}

/// L'installation d'une AgentDefinition dans UN workspace (le "où" et le
/// "avec quels droits"). Tout ce qui découle d'un agent (exécutions,
/// mémoire, messages, planification) référence une AgentInstallation,
/// jamais directement une AgentDefinition — garantit l'isolation
/// multi-tenant dès le modèle de données (voir ADR 0007).
model AgentInstallation {
  id                 String                  @id @default(cuid())
  organizationId     String
  workspaceId        String
  definitionId       String
  status             AgentInstallationStatus @default(INSTALLED)
  config             Json?
  grantedToolKeys    String[]                @default([])
  grantedPermissions String[]                @default([])
  usageLimits        Json?
  installedById      String?
  installedAt        DateTime                @default(now())
  uninstalledAt      DateTime?
  suspendedAt        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  definition   AgentDefinition @relation(fields: [definitionId], references: [id])
  installedBy  User?           @relation("AgentInstalledBy", fields: [installedById], references: [id])

  runs                 AgentRun[]
  memoryEntries        AgentMemoryEntry[]
  schedules            AgentSchedule[]
  messagesFrom         AgentMessage[]             @relation("AgentMessageFrom")
  messagesTo           AgentMessage[]             @relation("AgentMessageTo")
  interventionRequests AgentInterventionRequest[]
  plans                AgentPlan[]
  planStepsAsTarget    AgentPlanStep[]            @relation("AgentPlanStepTarget")
  commercialProspects  CommercialProspect[]
  commercialActions    CommercialAction[]

  @@unique([workspaceId, definitionId])
  @@index([organizationId])
  @@index([workspaceId, status])
}

/// Registre déclaratif des outils qu'un agent peut se voir accorder.
/// Une ligne par outil ; l'implémentation réelle (le code appelé) vit dans
/// src/lib/agents/tool-registry.ts et est référencée par `key`.
model AgentTool {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  description  String?
  category     String
  inputSchema  Json?
  outputSchema Json?
  isBuiltIn    Boolean  @default(true)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  TIMED_OUT
}

enum AgentRunTrigger {
  MANUAL
  SCHEDULED
  EVENT
  API
  /// Exécution créée par délégation d'un autre agent (voir v0.4, Agent
  /// Director) — distincte de MANUAL (humain) et API (appelant externe).
  AGENT
}

/// Une exécution d'agent. File d'attente interne sur PostgreSQL (voir ADR
/// 0008) : `status=QUEUED` + `scheduledAt` jouent le rôle de file, traitée
/// par `processQueuedAgentRuns` (src/lib/agents/execution-engine.ts).
model AgentRun {
  id             String          @id @default(cuid())
  installationId String
  status         AgentRunStatus  @default(QUEUED)
  trigger        AgentRunTrigger @default(MANUAL)
  priority       Int             @default(0)
  input          Json?
  output         Json?
  error          Json?
  attempt        Int             @default(0)
  maxAttempts    Int             @default(1)
  timeoutMs      Int             @default(30000)
  scheduledAt    DateTime        @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  cancelledAt    DateTime?
  parentRunId    String?
  createdById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  installation AgentInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  parentRun    AgentRun?         @relation("AgentRunRetry", fields: [parentRunId], references: [id])
  retries      AgentRun[]        @relation("AgentRunRetry")
  createdBy    User?             @relation("AgentRunCreatedBy", fields: [createdById], references: [id])

  logs                 AgentRunLog[]
  aiRequests           AIRequest[]
  messages             AgentMessage[]
  interventionRequests AgentInterventionRequest[]
  directorPlan         AgentPlan?                 @relation("AgentPlanOwnerRun")
  planStep             AgentPlanStep?             @relation("AgentPlanStepSubRun")

  @@index([installationId, status])
  @@index([status, scheduledAt])
}

/// Journal d'exécution consultable depuis l'UI (distinct des logs pino
/// applicatifs, qui ne sont pas requêtables depuis l'interface).
model AgentRunLog {
  id        String   @id @default(cuid())
  runId     String
  level     String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

enum AgentMemoryScope {
  SHORT_TERM
  PERSISTENT
  SHARED
}

/// Mémoire d'agent à trois portées (voir ADR 0009) : SHORT_TERM/PERSISTENT
/// scopées à une installation, SHARED scopée au workspace
/// (installationId nul). `embedding` réservé pour une vectorisation
/// future, jamais renseigné par le code actuel. L'unicité par
/// (portée, clé) est appliquée côté application (src/lib/agents/memory.ts,
/// seul point d'écriture), pas par contrainte SQL — une contrainte unique
/// classique ne peut pas distinguer plusieurs lignes SHARED dont
/// installationId est NULL (NULL n'est jamais égal à NULL en SQL).
model AgentMemoryEntry {
  id             String           @id @default(cuid())
  workspaceId    String
  installationId String?
  scope          AgentMemoryScope
  key            String
  value          Json
  embedding      Json?
  expiresAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installation AgentInstallation? @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@index([workspaceId, scope, key])
  @@index([installationId, scope, key])
  @@index([expiresAt])
}

enum AgentMessageType {
  TASK_REQUEST
  TASK_RESPONSE
  RESULT
  ERROR
  INTERVENTION_REQUEST
  INFO
}

enum AgentMessageStatus {
  PENDING
  DELIVERED
  READ
  ACTIONED
}

/// Communication inter-agents et agent<->humain, systématiquement
/// historisée (jamais de mutation/suppression, uniquement des lignes
/// nouvelles + changement de `status`).
model AgentMessage {
  id                 String             @id @default(cuid())
  workspaceId        String
  fromInstallationId String?
  toInstallationId   String?
  runId              String?
  type               AgentMessageType
  status             AgentMessageStatus @default(PENDING)
  payload            Json
  createdAt          DateTime           @default(now())
  deliveredAt        DateTime?
  readAt             DateTime?

  workspace           Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fromInstallation    AgentInstallation?        @relation("AgentMessageFrom", fields: [fromInstallationId], references: [id])
  toInstallation      AgentInstallation?        @relation("AgentMessageTo", fields: [toInstallationId], references: [id])
  run                 AgentRun?                 @relation(fields: [runId], references: [id])
  interventionRequest AgentInterventionRequest?

  @@index([workspaceId, createdAt])
  @@index([toInstallationId])
  @@index([fromInstallationId])
}

enum AgentInterventionStatus {
  PENDING
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

/// Demande d'intervention humaine ("human in the loop"), typiquement créée
/// à partir d'un AgentMessage de type INTERVENTION_REQUEST.
model AgentInterventionRequest {
  id               String                  @id @default(cuid())
  workspaceId      String
  installationId   String
  runId            String?
  messageId        String?                 @unique
  title            String
  description      String?
  status           AgentInterventionStatus @default(PENDING)
  assignedToUserId String?
  resolvedById     String?
  resolvedAt       DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installation AgentInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  run          AgentRun?         @relation(fields: [runId], references: [id])
  message      AgentMessage?     @relation(fields: [messageId], references: [id])
  assignedTo   User?             @relation("AgentInterventionAssignedTo", fields: [assignedToUserId], references: [id])
  resolvedBy   User?             @relation("AgentInterventionResolvedBy", fields: [resolvedById], references: [id])

  @@index([workspaceId, status])
}

enum AgentScheduleKind {
  ONE_OFF
  RECURRING
  EVENT
}

/// Planification des exécutions : ponctuelle (runAt), récurrente
/// (cronExpression), ou déclenchée par un évènement applicatif
/// (eventKey — ex. "lead.qualified"), traitée par
/// processDueAgentSchedules (src/lib/agents/scheduler.ts).
model AgentSchedule {
  id             String            @id @default(cuid())
  installationId String
  kind           AgentScheduleKind
  cronExpression String?
  runAt          DateTime?
  eventKey       String?
  input          Json?
  isActive       Boolean           @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  installation AgentInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@index([installationId])
  @@index([isActive, nextRunAt])
}

// ---------------------------------------------------------------------------
// Agent Director — orchestration (v0.4). Le Director est un agent comme les
// autres (AgentDefinition + AgentInstallation, exécuté par le même moteur
// d'exécution) ; ces deux modèles ajoutent uniquement la structure d'un plan
// d'exécution multi-étapes qu'un agent orchestrateur peut produire et piloter.
// Voir docs/adr/0010, 0011, 0012 et docs/02-ARCHITECTURE.md §11.
// ---------------------------------------------------------------------------

enum AgentPlanStatus {
  DRAFT
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AgentPlanStepStatus {
  PENDING
  READY
  DELEGATED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  CANCELLED
}

/// Plan d'exécution généré par un agent orchestrateur (le Director, dans
/// cette version) en réponse à une demande. `installationId` est toujours
/// l'installation orchestratrice propriétaire du plan — jamais celle d'un
/// agent délégué (voir `AgentPlanStep.targetInstallationId`). `runId`
/// référence l'AgentRun du Director qui a produit ce plan (1:1).
model AgentPlan {
  id             String          @id @default(cuid())
  workspaceId    String
  installationId String
  runId          String?         @unique
  goal           String
  status         AgentPlanStatus @default(DRAFT)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  startedAt      DateTime?
  finishedAt     DateTime?

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installation AgentInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  run          AgentRun?         @relation("AgentPlanOwnerRun", fields: [runId], references: [id])
  steps        AgentPlanStep[]

  @@index([workspaceId, status])
  @@index([installationId])
}

/// Une étape d'un plan d'exécution. `targetInstallationId` est résolu soit
/// explicitement (fourni à la création du plan), soit dynamiquement au
/// moment de la délégation à partir de `targetCategory` (voir
/// `src/lib/agents/director/delegation-engine.ts`) — les deux champs
/// peuvent coexister le temps de la résolution. `dependsOnStepIds`
/// référence d'autres `AgentPlanStep.id` du même plan ; seules des
/// références vers des étapes d'index strictement inférieur sont acceptées
/// à la création (voir `planning-engine.ts`), ce qui exclut trivialement
/// tout cycle. `subRunId` référence l'AgentRun réellement créé pour
/// l'agent délégué (1:1, `null` tant que l'étape n'a pas été déléguée).
model AgentPlanStep {
  id                   String              @id @default(cuid())
  planId               String
  stepIndex            Int
  objective            String
  targetInstallationId String?
  targetCategory       String?
  priority             Int                 @default(0)
  dependsOnStepIds     String[]            @default([])
  requiredToolKeys     String[]            @default([])
  requiredPermissions  String[]            @default([])
  input                Json?
  status               AgentPlanStepStatus @default(PENDING)
  subRunId             String?             @unique
  startedAt            DateTime?
  finishedAt           DateTime?
  durationMs           Int?
  result               Json?
  error                Json?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  plan               AgentPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  targetInstallation AgentInstallation? @relation("AgentPlanStepTarget", fields: [targetInstallationId], references: [id])
  subRun             AgentRun?          @relation("AgentPlanStepSubRun", fields: [subRunId], references: [id])

  @@index([planId, stepIndex])
  @@index([targetInstallationId])
}

// ---------------------------------------------------------------------------
// Agent Commercial (v0.5) — premier agent MÉTIER d'Autorun, construit
// intégralement sur le Framework des Agents (v0.3) et l'Agent Director
// (v0.4) : aucune table ici ne remplace `AgentInstallation`/`AgentRun`, elle
// les complète. `CommercialProspect`/`CommercialAction` sont volontairement
// distincts du `Lead`/`Opportunity`/`Quote` de Provence 360 (spécifiques au
// vertical photographie 360°, jamais généralisés — voir MOD-02, toujours
// reporté) : le Commercial doit rester un agent générique, réutilisable par
// n'importe quel futur vertical, pas câblé sur les catégories Provence 360.
// Voir docs/adr/0014 et docs/02-ARCHITECTURE.md §12.
// ---------------------------------------------------------------------------

enum CommercialStage {
  NEW
  TO_QUALIFY
  QUALIFIED
  FIRST_CONTACT
  FOLLOW_UP
  MEETING
  QUOTE_SENT
  NEGOTIATION
  WON
  LOST
}

/// Fiche prospect gérée par une installation de l'Agent Commercial.
/// `installationId` est toujours requis : un prospect appartient à
/// l'installation qui le gère (même principe que `AgentMemoryEntry`
/// scopée à une installation) — jamais une table globale non rattachée au
/// Framework.
model CommercialProspect {
  id                 String          @id @default(cuid())
  organizationId     String
  workspaceId        String
  installationId     String
  companyName        String
  sector             String?
  companySize        String?
  website            String?
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  stage              CommercialStage @default(NEW)
  score              Int?
  scoreBreakdown     Json?
  potentialEstimate  Json?
  qualificationNotes String?
  source             String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installation AgentInstallation  @relation(fields: [installationId], references: [id], onDelete: Cascade)
  actions      CommercialAction[]

  @@index([workspaceId, stage])
  @@index([installationId])
}

enum CommercialActionType {
  EMAIL_DRAFT
  FOLLOW_UP
  QUOTE_DRAFT
  PROPOSAL
  RECOMMENDATION
}

enum CommercialActionStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
  DISMISSED
}

/// Action proposée par l'Agent Commercial sur un prospect (email, relance,
/// devis, proposition, recommandation) — un seul modèle générique plutôt
/// qu'une table par type, pour rester facilement extensible (un nouveau
/// type d'action = une valeur d'enum, jamais une nouvelle table) et pour
/// que le système d'approbation soit uniforme (voir ADR 0017). Toujours
/// créée `PENDING_APPROVAL` sauf mode autonome explicitement activé
/// (`AgentInstallation.config.autonomousMode`, désactivé par défaut).
model CommercialAction {
  id             String                 @id @default(cuid())
  organizationId String
  workspaceId    String
  prospectId     String
  installationId String
  type           CommercialActionType
  status         CommercialActionStatus @default(PENDING_APPROVAL)
  title          String
  payload        Json
  reasoning      String?
  autoApproved   Boolean                @default(false)
  createdAt      DateTime               @default(now())
  decidedById    String?
  decidedAt      DateTime?
  sentAt         DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  prospect     CommercialProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  installation AgentInstallation  @relation(fields: [installationId], references: [id], onDelete: Cascade)
  decidedBy    User?              @relation("CommercialActionDecidedBy", fields: [decidedById], references: [id])

  @@index([workspaceId, status])
  @@index([prospectId])
}

/// Moteur de prompts (v0.5) : générique, utilisable par n'importe quel
/// agent (pas seulement le Commercial). Chaque prompt est versionné
/// (`@@unique([key, version])`), modifiable sans redéploiement (nouvelle
/// version en base), documenté (`description`), séparé du code (le
/// texte du template vit en base, pas dans une chaîne TypeScript). Une
/// seule version active par `key` à la fois.
model PromptTemplate {
  id          String   @id @default(cuid())
  key         String
  version     Int
  name        String
  description String?
  category    String
  template    String
  variables   String[] @default([])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  createdById String?

  createdBy User? @relation("PromptTemplateCreatedBy", fields: [createdById], references: [id])

  @@unique([key, version])
  @@index([key, isActive])
}
