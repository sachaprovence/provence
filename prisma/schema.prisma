  type           LeadSourceType
  label          String
  fileName       String?
  importedById   String?
  createdAt      DateTime       @default(now())

  leads Lead[]

  @@index([organizationId])
}

model Lead {
  id             String  @id @default(cuid())
  organizationId String
  // Sous-espace de travail au sein de l'organisation (voir ADR 0005).
  // Nullable et non exploité pour le filtrage aujourd'hui par les routes
  // existantes (qui continuent de scoper par organizationId uniquement) ;
  // sert de première preuve de concept du scoping par workspace et aux
