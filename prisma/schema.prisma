enum EmailProviderKind {
  DEMO
  SMTP
  GMAIL_API
  OUTLOOK_API
}

model EmailAccount {
  id             String            @id @default(cuid())
  organizationId String
  providerKind   EmailProviderKind @default(DEMO)
  fromName       String
  fromEmail      String
  dailyLimit     Int               @default(50)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([organizationId])
}

enum MessageType {
  FIRST_CONTACT_EMAIL
  FOLLOW_UP_SHORT
  FOLLOW_UP_CASE_STUDY
  LINKEDIN
  CALL_SCRIPT
  SMS
  PROPOSAL
  APPOINTMENT_BRIEF
}

enum MessageTone {
  PROFESSIONAL
  DIRECT_MODERN
  PREMIUM
}

enum MessageLanguage {
  FR
  EN
  HR
  IT
  ES
}

enum MessageStatus {
  DRAFT
  PENDING_VALIDATION
  APPROVED
  REJECTED
  SENT
  FAILED
}

model Message {
  id                String          @id @default(cuid())
  leadId            String
  enrollmentId      String?
  sequenceStepId    String?
  emailAccountId    String?
  type              MessageType
  channel           SequenceChannel @default(EMAIL)
  tone              MessageTone     @default(PROFESSIONAL)
  language          MessageLanguage @default(FR)
  subject           String?
  body              String
  status            MessageStatus   @default(DRAFT)
  aiRequestId       String?
  validatedById     String?
  validatedAt       DateTime?
  sentAt            DateTime?
  providerMessageId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  lead         Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  enrollment   Enrollment?   @relation(fields: [enrollmentId], references: [id])
  sequenceStep SequenceStep? @relation(fields: [sequenceStepId], references: [id])
  emailAccount EmailAccount? @relation(fields: [emailAccountId], references: [id])
  validatedBy  User?         @relation("MessageValidatedBy", fields: [validatedById], references: [id])
  events       EmailEvent[]

  @@index([leadId])
  @@index([status])
}

enum EmailEventType {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  OPENED
  REPLIED
  UNSUBSCRIBED
  FAILED
}

model EmailEvent {
  id        String         @id @default(cuid())
  messageId String
  type      EmailEventType
  metadata  Json?
  createdAt DateTime       @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

enum ReplyIntent {
  INTERESTED
  INFO_REQUEST
  PRICE_REQUEST
  CALLBACK_REQUEST
  NOT_INTERESTED
  ALREADY_EQUIPPED
  WRONG_CONTACT
  UNSUBSCRIBE
  AUTO_REPLY
  INVALID_ADDRESS
  UNKNOWN
}

model Conversation {
  id          String          @id @default(cuid())
  leadId      String
  channel     SequenceChannel @default(EMAIL)
  direction   String
  fromAddress String?
  toAddress   String?
  subject     String?
  body        String
  intent      ReplyIntent?
  aiRequestId String?
  createdAt   DateTime        @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

