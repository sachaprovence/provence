// Provence 360 — schéma de données
// Voir docs/02-ARCHITECTURE.md pour la description des entités et relations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Organisation, utilisateurs, rôles
// ---------------------------------------------------------------------------

enum MembershipRole {
  OWNER_ADMIN
  SALES
  PROVIDER
}

// Rôle au niveau *workspace* (voir ADR 0005/0006) — distinct et additif par
// rapport à `MembershipRole` (rôle d'organisation, inchangé). N'est consommé
// que par `WorkspaceMembership` et `src/lib/workspace-permissions.ts`.
enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  COMMERCIAL
  OPERATOR
  ACCOUNTANT
  SUPPORT
  VIEWER
}

model Organization {
  id                       String             @id @default(cuid())
  name                     String
  description              String?
  website                  String?
  logoUrl                  String?
  services                 String[]           @default([])
  zones                    String[]           @default([])
  pricingNote              String?
  pitch                    String?
  testimonials             Json[]             @default([])
  portfolioLinks           String[]           @default([])
  availabilityNote         String?
  tone                     String             @default("professionnel")
  emailSignature           String?
  dailySendLimit           Int                @default(50)
  rampUpEnabled            Boolean            @default(true)
  scoringRules             Json?
  requireMessageValidation Boolean            @default(true)
  /// Coordonnées légales/facturation (v0.9) — utilisées par les PDF de devis/factures et les paramètres.
  vatNumber                String?
  siret                    String?
  legalAddress             String?
  phone                    String?
  invoicePrefix            String?            @default("FA")
  quotePrefix              String?            @default("DEV")
  /// Quota IA mensuel dur en USD (v0.9 bis, AR-0051) — `null` = pas de quota (illimité, comportement inchangé pour les organisations existantes). Vérifié avant chaque appel IA réel (couche `src/lib/ai/` ET Framework des Agents), voir `src/lib/ai/quota.ts`.
  aiMonthlyBudgetUsd       Float?
  /// Plan d'abonnement actif (v1.0, AR-0062) — `null` = aucun plan (organisations créées avant v1.0, ou en cours d'onboarding). Appliquer un plan copie ses quotas (`dailySendLimit`/`aiMonthlyBudgetUsd`) sur l'organisation — voir `src/lib/billing/plan-service.ts#applyPlanToOrganization`, jamais une deuxième source de vérité pour les quotas déjà existants.
  planId                   String?
  /// Fournisseur de facturation actif au moment de la souscription ("demo" | "stripe") — voir `src/lib/billing/index.ts#getBillingProvider`, même convention que `AI_PROVIDER`/`EMAIL_PROVIDER`.
  billingProvider          String?
  /// Identifiant client chez le fournisseur de facturation (ex. Stripe Customer id, ou `demo-...` en mode démo).
  billingCustomerId        String?
  /// Identifiant d'abonnement chez le fournisseur de facturation.
  billingSubscriptionId    String?
  subscriptionStatus       SubscriptionStatus @default(TRIALING)
  subscriptionCanceledAt   DateTime?
  /// Capacité par créneau : nombre de rendez-vous/visites simultanés max (v1.1, AR-0179). `1` = comportement inchangé pour les organisations existantes (un seul créneau à la fois).
  appointmentSlotCapacity  Int                @default(1)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  memberships                 Membership[]
  workspaces                  Workspace[]
  agentDefinitions            AgentDefinition[]
  agentInstallations          AgentInstallation[]
  commercialProspects         CommercialProspect[]
  commercialActions           CommercialAction[]
  workflowDefinitions         WorkflowDefinition[]
  workflowRuns                WorkflowRun[]
  memoryEntries               MemoryEntry[]
  knowledgeDocuments          KnowledgeDocument[]
  embeddingRequests           EmbeddingRequest[]
  automations                 Automation[]
  automationRuns              AutomationRun[]
  automationJobs              AutomationJob[]
  territories                 Territory[]
  icps                        IdealCustomerProfile[]
  leads                       Lead[]
  tags                        Tag[]
  campaigns                   Campaign[]
  sequences                   Sequence[]
  emailAccounts               EmailAccount[]
  tasks                       Task[]
  appointments                Appointment[]
  opportunities               Opportunity[]
  quotes                      Quote[]
  quoteVersions               QuoteVersion[]
  invoices                    Invoice[]
  invoicePayments             InvoicePayment[]
  customers                   Customer[]
  missions                    Mission[]
  services_                   Service[]
  providers                   Provider[]
  automationRules             AutomationRule[]
  notifications               Notification[]
  suppressionEntries          SuppressionEntry[]
  consentRecords              ConsentRecord[]
  auditLogs                   AuditLog[]
  aiRequests                  AIRequest[]
  integrations                Integration[]
  integrationDiagnosticChecks IntegrationDiagnosticCheck[]
  webhookEvents               WebhookEvent[]
  loginEvents                 LoginEvent[]
  pipelineStages              PipelineStage[]
  businessHours               BusinessHours[]
  notificationPreferences     NotificationPreference[]
  companies                   Company[]
  properties                  Property[]
  contacts                    Contact[]
  attachments                 Attachment[]
  virtualTours                VirtualTour[]
  apiRequestMetrics           ApiRequestMetric[]
  comptaProducts              ComptaProduct[]
  comptaSales                 ComptaSale[]
  comptaSuppliers             ComptaSupplier[]
  comptaExpenses              ComptaExpense[]
  comptaCashCounts            ComptaCashCount[]
  comptaIngredients           ComptaIngredient[]
  comptaRecipeLines           ComptaRecipeLine[]
  comptaStockMovements        ComptaStockMovement[]
  comptaPurchaseOrders        ComptaPurchaseOrder[]
  comptaPurchasePayments      ComptaPurchasePayment[]
  comptaCashSessions          ComptaCashSession[]
  comptaCustomers             ComptaCustomer[]
  plan                        Plan?                        @relation(fields: [planId], references: [id])
  apiKeys                     ApiKey[]
  webhookSubscriptions        WebhookSubscription[]
  webhookDeliveries           WebhookDelivery[]
  onboardingProgress          OnboardingProgress?

  @@index([name])
  @@index([planId])
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  firstName        String
  lastName         String
  phone            String?
  avatarUrl        String?
  isActive         Boolean  @default(true)
  /// Administrateur de la PLATEFORME (v1.4) — distinct de tout rôle d'organisation/workspace :
  /// accès en lecture/écriture à `/admin/**`, à travers TOUTES les organisations. Jamais posé
  /// via l'API ou l'UI applicative — seulement via `scripts/promote-platform-admin.ts` (CLI,
  /// même convention que les autres scripts d'administration one-off de ce dépôt). `false` par
  /// défaut : comportement inchangé pour tout utilisateur existant.
  isPlatformAdmin  Boolean  @default(false)
  /// Secret TOTP (base32) — non `null` uniquement pendant/après l'inscription 2FA (v0.10, AR-0058). Jamais exposé via l'API.
  twoFactorSecret  String?
  /// `true` seulement après confirmation du code lors de l'inscription — voir `src/lib/two-factor.ts`. Non appliqué à la connexion (préparation, pas encore obligatoire).
  twoFactorEnabled Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  memberships                    Membership[]
  workspaceMemberships           WorkspaceMembership[]
  workspaceInvitationsSent       WorkspaceInvitation[]        @relation("WorkspaceInvitationInvitedBy")
  agentInstallationsInstalled    AgentInstallation[]          @relation("AgentInstalledBy")
  agentRunsCreated               AgentRun[]                   @relation("AgentRunCreatedBy")
  agentInterventionsAssigned     AgentInterventionRequest[]   @relation("AgentInterventionAssignedTo")
  agentInterventionsResolved     AgentInterventionRequest[]   @relation("AgentInterventionResolvedBy")
  commercialActionsDecided       CommercialAction[]           @relation("CommercialActionDecidedBy")
  promptTemplatesCreated         PromptTemplate[]             @relation("PromptTemplateCreatedBy")
  workflowDefinitionsCreated     WorkflowDefinition[]         @relation("WorkflowDefinitionCreatedBy")
  workflowVersionsCreated        WorkflowVersion[]            @relation("WorkflowVersionCreatedBy")
  workflowRunsCreated            WorkflowRun[]                @relation("WorkflowRunCreatedBy")
  memoryEntriesCreated           MemoryEntry[]                @relation("MemoryEntryCreatedBy")
  knowledgeDocumentsCreated      KnowledgeDocument[]          @relation("KnowledgeDocumentCreatedBy")
  automationsCreated             Automation[]                 @relation("AutomationCreatedBy")
  integrationDiagnosticChecksRun IntegrationDiagnosticCheck[] @relation("IntegrationDiagnosticCheckRunBy")
  automationVersionsCreated      AutomationVersion[]          @relation("AutomationVersionCreatedBy")
  automationRunsCreated          AutomationRun[]              @relation("AutomationRunCreatedBy")
  sessions                       Session[]
  passwordResets                 PasswordResetToken[]
  loginEvents                    LoginEvent[]
  auditLogs                      AuditLog[]
  aiRequests                     AIRequest[]
  tasksAssigned                  Task[]                       @relation("TaskAssignee")
  appointments                   Appointment[]                @relation("AppointmentOwner")
  notifications                  Notification[]
  notificationPreferences        NotificationPreference[]
  messagesValidated              Message[]                    @relation("MessageValidatedBy")
  notesAuthored                  LeadNote[]
  attachmentsUploaded            Attachment[]
  apiKeysCreated                 ApiKey[]                     @relation("ApiKeyCreatedBy")
  webhookSubscriptionsCreated    WebhookSubscription[]        @relation("WebhookSubscriptionCreatedBy")
  comptaSalesCreated             ComptaSale[]
  comptaExpensesCreated          ComptaExpense[]
  comptaCashCountsCreated        ComptaCashCount[]
  comptaStockMovementsCreated    ComptaStockMovement[]
  comptaPurchaseOrdersCreated    ComptaPurchaseOrder[]
  comptaPurchasePaymentsCreated  ComptaPurchasePayment[]
  comptaCashSessionsOpened       ComptaCashSession[]          @relation("ComptaCashSessionOpenedBy")
  comptaCashSessionsClosed       ComptaCashSession[]          @relation("ComptaCashSessionClosedBy")
}

// ---------------------------------------------------------------------------
// Workspaces (sous-espaces au sein d'une organisation — voir ADR 0005)
// ---------------------------------------------------------------------------

model Workspace {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  isDefault      Boolean   @default(false)
  settings       Json?
  archivedAt     DateTime?
  archivedById   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  WorkspaceMembership[]
  invitations  WorkspaceInvitation[]
  sessions     Session[]
  leads        Lead[]

  agentInstallations        AgentInstallation[]
  agentMemoryEntries        AgentMemoryEntry[]
  agentMessages             AgentMessage[]
  agentInterventionRequests AgentInterventionRequest[]
  agentPlans                AgentPlan[]
  commercialProspects       CommercialProspect[]
  commercialActions         CommercialAction[]
  workflowDefinitions       WorkflowDefinition[]
  workflowRuns              WorkflowRun[]
  workflowTriggerBindings   WorkflowTriggerBinding[]
  memoryEntries             MemoryEntry[]
  knowledgeDocuments        KnowledgeDocument[]
  embeddingRequests         EmbeddingRequest[]
  automations               Automation[]
  automationRuns            AutomationRun[]
  automationJobs            AutomationJob[]
  automationTriggerBindings AutomationTriggerBinding[]
  companies                 Company[]
  properties                Property[]
  contacts                  Contact[]
  attachments               Attachment[]
  virtualTours              VirtualTour[]
  quoteVersions             QuoteVersion[]
  invoices                  Invoice[]
  comptaSales               ComptaSale[]
  comptaSuppliers           ComptaSupplier[]
  comptaExpenses            ComptaExpense[]
  comptaCashCounts          ComptaCashCount[]
  comptaCashSessions        ComptaCashSession[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model WorkspaceMembership {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  invitedById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model WorkspaceInvitation {
  id          String                    @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole
  token       String                    @unique
  status      WorkspaceInvitationStatus @default(PENDING)
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime                  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("WorkspaceInvitationInvitedBy", fields: [invitedById], references: [id])

  @@index([workspaceId])
  @@index([email])
}

model Membership {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole
  territoryId    String?
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  territory    Territory?   @relation(fields: [territoryId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model Session {
  id                String   @id @default(cuid())
  userId            String
  token             String   @unique
  userAgent         String?
  ipAddress         String?
  // Workspace actif de cette session — jamais fourni tel quel par le client :
  // toute mise à jour passe par une route serveur qui revérifie
  // `WorkspaceMembership` avant d'écrire ce champ (voir ADR 0005,
  // src/lib/workspace-context.ts).
  activeWorkspaceId String?
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeWorkspace Workspace? @relation(fields: [activeWorkspaceId], references: [id])

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginEvent {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  email          String
  success        Boolean
  reason         String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([organizationId])
  /// Verrouillage de compte (v0.10, AR-0155) — compte les échecs récents par email dans une fenêtre glissante.
  @@index([email, createdAt])
}

// ---------------------------------------------------------------------------
// Territoires & prestataires
// ---------------------------------------------------------------------------

model Territory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  centerCity     String
  radiusKm       Int      @default(40)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]
  providers    Provider[]
  leads        Lead[]
  missions     Mission[]

  @@unique([organizationId, name])
}

model Provider {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  territoryId    String?
  name           String
  email          String
  phone          String?
  specialties    String[] @default([])
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  territory    Territory?   @relation(fields: [territoryId], references: [id])
  missions     Mission[]

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Ciblage : ICP
// ---------------------------------------------------------------------------

enum LeadCategory {
  AIRBNB_HOST
  VILLA
  HOTEL
  CAMPING
  REAL_ESTATE_AGENCY
  RESTAURANT
  EVENT_VENUE
  RETAIL
  /// Commerce de proximité (hors restaurant/hôtel) — v0.9.
  COMMERCE
  /// Architecte — souvent prescripteur plutôt que client final — v0.9.
  ARCHITECT
  /// Notaire — souvent prescripteur (transactions immobilières) — v0.9.
  NOTARY
  /// Promoteur/constructeur immobilier — v0.9.
  CONSTRUCTOR
  /// Collectivité territoriale (mairie, office de tourisme...) — v0.9.
  MUNICIPALITY
  OTHER
}

model IdealCustomerProfile {
  id                     String       @id @default(cuid())
  organizationId         String
  name                   String
  category               LeadCategory
  zones                  String[]     @default([])
  sizeNote               String?
  priceRange             String?
  estimatedUnits         String?
  hasVirtualTourExpected Boolean      @default(false)
  websiteQualityNote     String?
  socialPresenceNote     String?
  minRating              Float?
  minReviewCount         Int?
  priority               Int          @default(3)
  positiveKeywords       String[]     @default([])
  exclusionCriteria      String[]     @default([])
  isActive               Boolean      @default(true)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Prospects (Lead)
// ---------------------------------------------------------------------------

enum LeadStage {
  NEW
  TO_ANALYZE
  QUALIFIED
  MESSAGE_TO_VALIDATE
  CONTACTED
  FOLLOW_UP_SCHEDULED
  REPLIED
  INTERESTED
  APPOINTMENT_SCHEDULED
  QUOTE_SENT
  NEGOTIATION
  WON
  LOST
  TO_RECONTACT_LATER
  UNSUBSCRIBED
}

/// Catégorie de reporting d'une étape de pipeline personnalisée — voir `PipelineStage` (v0.9, ADR 0038).
enum PipelineStageCategory {
  OPEN
  WON
  LOST
}

/// Personnalisation d'AFFICHAGE du pipeline (libellé/couleur/ordre) — jamais la source de vérité métier,
/// qui reste `Lead.stage` (l'enum `LeadStage`, inchangé). Seedée 1:1 avec `LeadStage` à la création de
/// chaque organisation — voir ADR 0038 et `src/lib/crm/pipeline-service.ts`.
model PipelineStage {
  id             String                @id @default(cuid())
  organizationId String
  /// Correspond toujours à une valeur de `LeadStage` — jamais une étape "libre" sans sémantique métier.
  stageKey       LeadStage
  label          String
  color          String                @default("#6b7280")
  order          Int                   @default(0)
  category       PipelineStageCategory @default(OPEN)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, stageKey])
  @@index([organizationId, order])
}

/// Horaires d'ouverture par jour de la semaine (v1.1, AR-0179) — consommé par
/// `src/lib/agents/tools/planning-tools.ts#suggestSlotsTool` pour ne proposer que des créneaux
/// réellement disponibles. Absence de ligne pour un jour donné = aucune restriction (comportement
/// inchangé pour les organisations qui n'ont rien configuré). Horaires exprimés en UTC
/// ("HH:mm") — aucune conversion de fuseau horaire par organisation (simplification assumée,
/// voir ADR correspondant).
model BusinessHours {
  id             String   @id @default(cuid())
  organizationId String
  /// 0 = dimanche ... 6 = samedi (convention `Date.prototype.getUTCDay()`).
  dayOfWeek      Int
  isOpen         Boolean  @default(true)
  /// Heure d'ouverture au format "HH:mm" (UTC) — `null` si `isOpen` est `false`, ou si aucune restriction d'horaire n'est fixée pour ce jour ouvert.
  opensAt        String?
  /// Heure de fermeture au format "HH:mm" (UTC).
  closesAt       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dayOfWeek])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Entreprises (regroupement multi-établissements) & biens immobiliers (v0.9)
// ---------------------------------------------------------------------------

/// Regroupement optionnel de plusieurs `Lead` sous une même entité juridique
/// (groupe hôtelier, réseau d'agences...) — additif, jamais requis (voir ADR 0038).
model Company {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String?
  name           String
  legalName      String?
  siret          String?
  website        String?
  address        String?
  city           String?
  country        String   @default("France")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?               @relation(fields: [workspaceId], references: [id])
  leads        Lead[]
  properties   Property[]
  contactLinks CompanyContactRelation[]

  @@index([organizationId])
  @@index([workspaceId])
}

/// Personne physique (v1.1, AR-0160) — SCOPÉE organisation/workspace, jamais à un seul `Lead` : peut être
/// liée à plusieurs `Lead`/`Company` (gérant de plusieurs établissements, prescripteur lié à plusieurs
/// prospects). Distincte et additive par rapport à `LeadContact` (contact opérationnel de messagerie,
/// scopé à un seul Lead, inchangé — voir ADR 0043 : migrer/retirer LeadContact aurait cassé 15+ points
/// d'appel de résolution d'email/téléphone pour un bénéfice disproportionné).
model Contact {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String?
  fullName       String
  jobTitle       String?
  email          String?
  phone          String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?               @relation(fields: [workspaceId], references: [id])
  leadLinks    LeadContactRelation[]
  companyLinks CompanyContactRelation[]

  @@index([organizationId])
  @@index([workspaceId])
  @@index([email])
}

/// Liaison N:N `Contact`↔`Lead` avec rôle optionnel (v1.1, AR-0160) — clés étrangères réelles
/// (contrairement à la convention polymorphe `entityType`/`entityId` d'`Attachment`, jugée trop faible
/// en intégrité référentielle pour une notion aussi centrale, voir ADR 0043).
model LeadContactRelation {
  id        String   @id @default(cuid())
  contactId String
  leadId    String
  role      String?
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([contactId, leadId])
  @@index([leadId])
  @@index([contactId])
}

/// Liaison N:N `Contact`↔`Company` avec rôle optionnel (v1.1, AR-0160) — même patron que
/// `LeadContactRelation`.
model CompanyContactRelation {
  id        String   @id @default(cuid())
  contactId String
  companyId String
  role      String?
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([contactId, companyId])
  @@index([companyId])
  @@index([contactId])
}

/// Type physique d'un bien immobilier ("Bien immobilier" du brief v0.9) — distinct de `LeadCategory`
/// (qui catégorise l'ÉTABLISSEMENT/client, pas le bien lui-même : une agence immobilière représente
/// plusieurs biens de types différents).
enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  COMMERCIAL_PREMISES
  HOTEL_ROOM
  OFFICE
  LAND
  OTHER
}

/// Le bien physique candidat à une visite virtuelle — distinct du `Lead` qui le représente
/// commercialement (une agence immobilière/un notaire/un architecte représente PLUSIEURS biens).
/// Voir ADR 0038.
model Property {
  id             String       @id @default(cuid())
  organizationId String
  workspaceId    String?
  leadId         String
  companyId      String?
  type           PropertyType @default(OTHER)
  label          String
  address        String?
  city           String?
  region         String?
  country        String       @default("France")
  latitude       Float?
  longitude      Float?
  surfaceM2      Float?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?    @relation(fields: [workspaceId], references: [id])
  lead         Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  company      Company?      @relation(fields: [companyId], references: [id])
  virtualTours VirtualTour[]

  @@index([organizationId])
  @@index([leadId])
  @@index([companyId])
}

/// Catégorie de pièce jointe générique — documents/photos/liens (brief v0.9 : "chronologie complète").
enum AttachmentCategory {
  DOCUMENT
  PHOTO
  LINK
}

/// Pièces jointes génériques (documents/photos/liens), réutilisées par plusieurs entités —
/// MÊME convention polymorphe que `AuditLog` (`entityType`/`entityId`, jamais une relation Prisma
/// dédiée par type d'entité). Voir ADR 0038.
model Attachment {
  id             String             @id @default(cuid())
  organizationId String
  workspaceId    String?
  /// Nom du modèle cible en dur (ex. "Lead", "Company", "Property", "VirtualTour", "Quote") — jamais
  /// une chaîne libre non contrôlée par le code appelant.
  entityType     String
  entityId       String
  category       AttachmentCategory
  fileName       String
  url            String
  /// Clé brute chez le fournisseur de stockage (ex. `<organizationId>/<uuid>-<nom>`),
  /// distincte de `url` — permet un téléchargement/suppression fiables auprès du
  /// StorageProvider sans dépendre du format d'URL publique, qui varie par
  /// fournisseur et peut changer (rotation de bucket/CDN). Nullable : les pièces
  /// jointes créées avant AR-0164 (v1.2) n'en ont pas — gérées en lecture seule
  /// pour la suppression physique (voir attachment-service.ts).
  storageKey     String?
  mimeType       String?
  sizeBytes      Int?
  uploadedById   String?
  createdAt      DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id])
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id])

  @@index([organizationId, entityType, entityId])
  @@index([workspaceId])
}

enum VirtualTourStatus {
  DRAFT
  SCHEDULED
  SHOOTING_DONE
  PROCESSING
  PUBLISHED
  ARCHIVED
}

/// Module métier dédié "Visites 3D" (brief v0.9) — lié à un `Mission` existant (réutilise sa
/// planification/son prestataire/son statut d'exécution) plutôt que de dupliquer ce mécanisme
/// (voir ADR 0038). Photos/documents via `Attachment` (entityType="VirtualTour"), facture via
/// `Invoice` (optionnelle, jamais générée automatiquement), historique via
/// `src/lib/crm/timeline-service.ts` (task #81).
model VirtualTour {
  id                       String            @id @default(cuid())
  organizationId           String
  workspaceId              String?
  leadId                   String
  missionId                String
  propertyId               String?
  invoiceId                String?
  type                     PropertyType      @default(OTHER)
  address                  String?
  latitude                 Float?
  longitude                Float?
  surfaceM2                Float?
  scheduledAt              DateTime?
  /// Durée prévue de la prise de vue, en minutes (v1.1, AR-0166).
  scheduledDurationMinutes Int?
  /// Matériel utilisé pour la prise de vue — texte libre (v1.1, AR-0166), ex. "Matterport Pro3, drone DJI Mini".
  equipmentUsed            String?
  status                   VirtualTourStatus @default(DRAFT)
  matterportUrl            String?
  tourUrl                  String?
  notes                    String?
  /// Livraison client (v1.1, AR-0167) — distinct du statut `PUBLISHED` : une visite peut être publiée en
  /// interne avant d'être formellement livrée/acceptée par le client (déclenche `virtual_tour.delivered`).
  deliveredAt              DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id])
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  mission      Mission      @relation(fields: [missionId], references: [id], onDelete: Cascade)
  property     Property?    @relation(fields: [propertyId], references: [id])
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id])

  @@index([organizationId])
  @@index([leadId])
  @@index([missionId])
  @@index([propertyId])
  @@index([workspaceId])
}

enum LeadSourceType {
  MANUAL
  CSV_IMPORT
  API
  REFERRAL
  OTHER
}

model LeadSource {
  id             String         @id @default(cuid())
