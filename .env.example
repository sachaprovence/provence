# Copier ce fichier en `.env` et adapter les valeurs pour le développement local.
# En Docker Compose, ces variables sont déjà définies dans docker-compose.yml.

# --- Base de données ---------------------------------------------------------
DATABASE_URL="postgresql://provence:provence@localhost:5432/provence360?schema=public"

# --- Authentification ---------------------------------------------------------
# Secret utilisé pour signer les liens de désinscription (HMAC). À changer en
# production. Doit contenir au moins 16 caractères — validé au démarrage du
# serveur (voir src/lib/env.ts et src/instrumentation.ts) : le serveur refuse
# de démarrer si cette variable est absente ou trop courte.
AUTH_SECRET="change-me-in-production"

# --- Fournisseurs (mode démo par défaut) --------------------------------------
# "demo" = aucun service externe requis, aucune clé nécessaire.
# Pour brancher un vrai fournisseur : implémenter l'interface correspondante
# (voir src/lib/ai/ et src/lib/email/) puis changer cette valeur.
AI_PROVIDER="demo"
EMAIL_PROVIDER="demo"

# Clé API du fournisseur IA réel (si AI_PROVIDER != "demo").
# NE JAMAIS exposer cette clé côté navigateur (pas de préfixe NEXT_PUBLIC_).
# AI_API_KEY=""

# --- Application ---------------------------------------------------------
# URL publique de l'application, utilisée pour générer les liens de désinscription.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Tâches planifiées ---------------------------------------------------------
# Secret partagé pour autoriser un vrai cron système à appeler
# POST /api/cron/process-sequences avec l'en-tête `Authorization: Bearer <CRON_SECRET>`.
# Optionnel : sans cron externe, un bouton "Traiter les relances maintenant" est
# disponible dans le tableau de bord en mode démo.
# CRON_SECRET=""

# --- Facturation SaaS (mode démo par défaut, v1.0) ----------------------------
# "demo" = abonnement activé immédiatement, sans configuration externe.
BILLING_PROVIDER="demo"

# Clés Stripe réelles (si BILLING_PROVIDER="stripe"). Configurer un webhook
# Stripe pointant vers POST /api/billing/webhook, et renseigner
# Plan.stripePriceId pour chaque plan (Starter/Pro/Entreprise) côté Stripe.
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# --- Stockage de fichiers (mode démo par défaut, v1.1) ------------------------
# "demo" = écrit sur le système de fichiers local du serveur, servi par
# GET /api/storage/demo/[...path] (authentifié, scopé par organisation).
# ATTENTION : en conteneur (Docker) sans volume persistant dédié, les fichiers
# écrits en mode démo sont perdus à chaque redéploiement/redémarrage — voir
# docker-compose.yml. Utiliser "s3" (ou tout stockage compatible S3 : MinIO,
# Cloudflare R2, Scaleway...) pour un usage en production réelle.
STORAGE_PROVIDER="demo"

# Requis si STORAGE_PROVIDER="s3" (voir src/lib/storage/providers/s3.ts).
# NE JAMAIS exposer ces clés côté navigateur (pas de préfixe NEXT_PUBLIC_).
# STORAGE_S3_BUCKET=""
# STORAGE_S3_REGION=""
# STORAGE_S3_ACCESS_KEY_ID=""
# STORAGE_S3_SECRET_ACCESS_KEY=""
# Optionnel : hôte S3 compatible (MinIO/R2/Scaleway) si différent d'AWS S3.
# STORAGE_S3_ENDPOINT=""
# Optionnel : base d'URL publique si différente de STORAGE_S3_ENDPOINT
# (ex. domaine CDN devant le bucket).
# STORAGE_S3_PUBLIC_URL_BASE=""

# Optionnel : délai maximal (ms) d'une requête S3 (upload/download/delete)
# avant abandon avec une erreur explicite de timeout. Défaut : 15000.
# STORAGE_S3_TIMEOUT_MS="15000"

# --- Validation des pièces jointes (v1.2, AR-0164) -----------------------------
# Appliquée par TOUS les fournisseurs de stockage (demo et s3), avant tout
# appel réseau — voir src/lib/storage/validation.ts.
# Optionnel : taille maximale (octets) d'un fichier téléversé. Défaut : 20 Mo
# (20971520). Une valeur absente, non numérique ou <= 0 retombe sur le défaut.
# STORAGE_MAX_FILE_SIZE_BYTES="20971520"

# Optionnel : liste blanche de types MIME acceptés, séparés par des virgules.
# Défaut : images courantes, PDF, texte/CSV, Word, Excel (voir
# DEFAULT_ALLOWED_MIME_TYPES dans src/lib/storage/validation.ts).
# STORAGE_ALLOWED_MIME_TYPES="image/jpeg,image/png,application/pdf"

# --- Journalisation ---------------------------------------------------------
# Niveau du logger structuré (src/lib/logger.ts) : fatal, error, warn, info,
# debug, trace ou silent. Optionnel — par défaut "debug" en développement et
# "info" en production.
# LOG_LEVEL="info"

# --- Compta Vellano (v1, module de comptabilité pizzeria) ---------------------
# Sous-fonctionnalités pas encore livrées, désactivées par défaut. Seule la
# string exacte "true" les active (voir src/lib/env.ts).
# COMPTA_OCR_ENABLED="false"
# COMPTA_AI_ASSISTANT_ENABLED="false"
