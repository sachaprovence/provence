# Copier ce fichier en `.env` et adapter les valeurs pour le développement local.
# En Docker Compose, ces variables sont déjà définies dans docker-compose.yml.

# --- Base de données ---------------------------------------------------------
DATABASE_URL="postgresql://provence:provence@localhost:5432/provence360?schema=public"

# --- Authentification ---------------------------------------------------------
# Secret utilisé pour signer les liens de désinscription (HMAC). À changer en production.
AUTH_SECRET="change-me-in-production"

# --- Fournisseurs (mode démo par défaut) --------------------------------------
# "demo" = aucun service externe requis, aucune clé nécessaire.
# Pour brancher un vrai fournisseur : implémenter l'interface correspondante
# (voir src/lib/ai/ et src/lib/email/) puis changer cette valeur.
AI_PROVIDER="demo"
EMAIL_PROVIDER="demo"

# Clé API du fournisseur IA réel (si AI_PROVIDER != "demo").
# NE JAMAIS exposer cette clé côté navigateur (pas de préfixe NEXT_PUBLIC_).
# AI_API_KEY=""

# --- Application ---------------------------------------------------------
# URL publique de l'application, utilisée pour générer les liens de désinscription.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Tâches planifiées ---------------------------------------------------------
# Secret partagé pour autoriser un vrai cron système à appeler
# POST /api/cron/process-sequences avec l'en-tête `Authorization: Bearer <CRON_SECRET>`.
# Optionnel : sans cron externe, un bouton "Traiter les relances maintenant" est
# disponible dans le tableau de bord en mode démo.
# CRON_SECRET=""
